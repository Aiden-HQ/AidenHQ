{
  "title": "github.pr: push these branches, then open (or update) each one's PR.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workspace",
    "only",
    "text"
  ],
  "properties": {
    "workspace": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9]*-[0-9]+$"
    },
    "only": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repo",
          "branch",
          "sha"
        ],
        "properties": {
          "repo": {
            "type": "string",
            "pattern": "^[\\w.-]+/[\\w.-]+$"
          },
          "branch": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[\\w./-]+$"
          },
          "sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        }
      }
    },
    "text": {
      "title": "the PR's title and body",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 300,
          "pattern": "^(feat|fix|docs|chore|test|refactor|perf|ci|build|style|revert)(\\([a-z0-9][a-z0-9._/-]*\\))?!?: \\S"
        },
        "body": {
          "type": "string",
          "maxLength": 60000
        }
      }
    },
    "hold": {
      "title": "put the ship:stop label on each PR, so no automatic merge takes it; a later publish without hold lifts it",
      "type": "boolean"
    },
    "heads": {
      "title": "the head each published branch had when the plan read it (filled by the plan, never by the caller): the record's own args carry it, so the card can only rewrite the branch from the head it was filed at (a null value: the branch did not exist then)",
      "type": "object",
      "additionalProperties": {
        "pattern": "^([0-9a-f]{40})?$"
      }
    }
  }
}
