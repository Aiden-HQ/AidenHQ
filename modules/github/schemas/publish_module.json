{
  "title": "github.publish_module: the owner's previewed local module, as one commit on a public repo's branch with its marketplace.json entry (docs/design/sharing.md).",
  "type": "object",
  "additionalProperties": false,
  "required": ["repo", "ref", "base", "source", "module", "files", "digest"],
  "properties": {
    "repo": { "type": "string", "pattern": "^[\\w.-]+/[\\w.-]+$" },
    "ref": { "type": "string", "pattern": "^(?!-)(?!.*\\.\\.)[\\w./-]{1,200}$" },
    "base": { "type": "string", "pattern": "^[0-9a-f]{40}$", "description": "The branch tip the owner previewed: the commit lands only on it." },
    "source": { "type": "string", "pattern": "^[0-9a-f]{40}$", "description": "The instance commit the module was exported at." },
    "module": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
    "files": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": { "type": "object", "additionalProperties": false, "required": ["path", "text"], "properties": { "path": { "type": "string", "pattern": "^(module\\.yaml|agents/[a-z0-9][a-z0-9-]*/AGENTS\\.md|skills/[\\w-][\\w.-]*(/[\\w-][\\w.-]*)*)$", "maxLength": 300 }, "text": { "type": "string", "maxLength": 524288 } } }
    },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
