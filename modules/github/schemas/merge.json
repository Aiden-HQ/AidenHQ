{
  "title": "github.merge: squash-merge these PRs, each only at this head and once its checks are green. With `generation`, one adopted PR, filed by ship for that adoption; `attempt` tells a new try at the same head from a repeat.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "prs"
  ],
  "properties": {
    "prs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "title": "a PR at its approved head",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repo",
          "number",
          "head"
        ],
        "properties": {
          "repo": {
            "type": "string",
            "pattern": "^[\\w.-]+/[\\w.-]+$"
          },
          "number": {
            "type": "integer",
            "minimum": 1
          },
          "head": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "base": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[\\w./-]+$"
          }
        }
      }
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    }
  }
}
