{
  "title": "github.repair: ship's deterministic repair of this adopted PR at exactly this head: its base merged in and its generated files regenerated by ship's check job, written as the App.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repo",
    "number",
    "head",
    "generation",
    "base",
    "plan"
  ],
  "properties": {
    "repo": {
      "type": "string",
      "pattern": "^[\\w.-]+/[\\w.-]+$"
    },
    "number": {
      "type": "integer",
      "minimum": 1
    },
    "head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "base": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[\\w./-]+$"
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ci_regenerates": {
          "type": "boolean",
          "description": "The repo's own CI regenerates the generated paths: the repair takes their base side and runs no generator for them."
        },
        "globs": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "commands": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dir",
              "cmd"
            ],
            "properties": {
              "dir": {
                "type": "string",
                "maxLength": 300
              },
              "cmd": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            }
          }
        }
      }
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    }
  }
}
