#!/usr/bin/env node
// engine@1 for opencode: job.json → opencode run (JSON events), the last text part → the final event.
import { engineIO, runProgram } from "../sdk/engine-io.ts";
import { opencodeCommand, opencodeEvents } from "../src/opencode.ts";

const io = engineIO(process.argv[2]);
const { argv, env } = opencodeCommand(io.spec);
const events = opencodeEvents(io.spec, io.emit);
const r = await runProgram(argv, { env, onJson: events.take });
const text = events.last().trim() || (r.error ? `The job couldn't start: ${r.error}.` : "");
if (text) io.emit({ t: "final", text });
process.exit(r.code);
