#!/usr/bin/env node
// engine@1 for Codex: job.json → codex exec (--json), its events → events.jsonl, its last message → the final event.
import { readFileSync } from "node:fs";
import { join } from "node:path";
import { engineIO, runProgram } from "../sdk/engine-io.ts";
import { codexCommand, codexEvents } from "../src/codex.ts";

const jobDir = process.argv[2];
const io = engineIO(jobDir);
const { argv, env } = codexCommand(io.spec, jobDir);
const events = codexEvents(io.spec, io.emit);
const r = await runProgram(argv, { env, input: io.spec.prompt, onJson: events.take });
let last = "";
try { last = readFileSync(join(jobDir, "last.md"), "utf8").trim(); } catch {}
const text = last || (r.error ? `The job couldn't start: ${r.error}.` : "");
if (text) io.emit({ t: "final", text });
process.exit(r.code);
