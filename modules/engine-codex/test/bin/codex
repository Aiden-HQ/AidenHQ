#!/usr/bin/env node
// A stand-in Codex for the contract kit: the prompt on stdin, a thread (the resumed one when asked), an answer in -o.
import { readFileSync, writeFileSync } from "node:fs";
const args = process.argv.slice(2);
readFileSync(0, "utf8");
const thread = args[1] === "resume" ? args[2] : "thread-1";
const say = (e) => console.log(JSON.stringify(e));
say({ type: "thread.started", thread_id: thread });
say({ type: "item.completed", item: { type: "agent_message", text: "ok" } });
say({ type: "turn.completed", usage: { input_tokens: 10, cached_input_tokens: 0, output_tokens: 1 } });
writeFileSync(args[args.indexOf("-o") + 1], "ok");
