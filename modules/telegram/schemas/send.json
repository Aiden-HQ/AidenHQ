{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action",
    "chat_id",
    "text",
    "agent"
  ],
  "properties": {
    "action": {
      "enum": [
        "send"
      ]
    },
    "chat_id": {
      "type": "string",
      "pattern": "^-?[0-9]{1,20}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "chat_title": {
      "type": "string",
      "maxLength": 200
    },
    "agent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    }
  }
}
