{
  "type": "object",
  "additionalProperties": false,
  "required": ["machine", "fingerprint", "pending_id", "quiet_window"],
  "properties": {
    "machine": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$" },
    "fingerprint": { "type": "string", "pattern": "^SHA256:[A-Za-z0-9+/]{43}$" },
    "pending_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "quiet_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
        "end": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" }
      }
    }
  }
}
