{
  "type": "object",
  "additionalProperties": false,
  "required": ["machine", "mode", "reboot_policy", "fingerprint", "packages", "hash"],
  "properties": {
    "machine": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$" },
    "mode": { "enum": ["security", "full"] },
    "reboot_policy": { "enum": ["auto", "ask"] },
    "fingerprint": { "type": "string", "pattern": "^SHA256:[A-Za-z0-9+/]{43}$" },
    "packages": {
      "type": "array",
      "maxItems": 5000,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9+.-]{0,199}=[A-Za-z0-9.+~:-]{1,200}$" }
    },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
