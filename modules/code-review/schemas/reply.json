{
 "type": "object",
 "additionalProperties": false,
 "required": [
  "repo",
  "pr",
  "head",
  "comment",
  "body"
 ],
 "properties": {
  "repo": {
   "type": "string",
   "pattern": "^[A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}$"
  },
  "pr": {
   "type": "integer",
   "minimum": 1
  },
  "head": {
   "type": "string",
   "pattern": "^[0-9a-f]{40}$"
  },
  "comment": {
   "type": "integer",
   "minimum": 1
  },
  "body": {
   "type": "string",
   "minLength": 1,
   "maxLength": 1600
  }
 }
}
