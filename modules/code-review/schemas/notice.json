{
 "type": "object",
 "additionalProperties": false,
 "required": [
  "repo",
  "pr",
  "head",
  "phase"
 ],
 "properties": {
  "repo": {
   "type": "string",
   "pattern": "^[A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}$"
  },
  "pr": {
   "type": "integer",
   "minimum": 1
  },
  "head": {
   "type": "string",
   "pattern": "^[0-9a-f]{40}$"
  },
  "identity": {
   "enum": [
    "auto",
    "app",
    "owner"
   ]
  },
  "phase": {
   "enum": [
    "queued",
    "running",
    "done",
    "skipped",
    "failed"
   ]
  },
  "reviewer": {
   "type": "string",
   "pattern": "^[A-Za-z0-9_.-]{1,40}$"
  },
  "reason": {
   "enum": [
    "draft",
    "fork",
    "budget_repo",
    "budget_instance",
    "superseded",
    "stopped",
    "unchanged",
    "ignored",
    "too_large",
    "no_access"
   ]
  },
  "important": {
   "type": "integer",
   "minimum": 0,
   "maximum": 9999
  },
  "nit": {
   "type": "integer",
   "minimum": 0,
   "maximum": 9999
  },
  "pre_existing": {
   "type": "integer",
   "minimum": 0,
   "maximum": 9999
  },
  "cost_usd": {
   "type": "number",
   "minimum": 0,
   "maximum": 100000
  },
  "run": {
   "type": "string",
   "pattern": "^[A-Za-z0-9_.-]{1,64}$"
  }
 }
}
