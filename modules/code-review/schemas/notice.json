{
 "type": "object",
 "additionalProperties": false,
 "required": [
  "repo",
  "pr",
  "head",
  "phase"
 ],
 "properties": {
  "repo": {
   "type": "string",
   "pattern": "^[A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}$"
  },
  "pr": {
   "type": "integer",
   "minimum": 1
  },
  "head": {
   "type": "string",
   "pattern": "^[0-9a-f]{40}$"
  },
  "identity": {
   "enum": [
    "auto",
    "app",
    "owner"
   ]
  },
  "phase": {
   "enum": [
    "queued",
    "running",
    "done",
    "skipped",
    "failed",
    "answered"
   ]
  },
  "engine": {
   "enum": [
    "codex",
    "claude-code",
    "codegenie",
    "codex-native"
   ]
  },
  "model": {
   "type": "string",
   "pattern": "^~?[A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.:~-]{1,100}$"
  },
  "effort": {
   "enum": [
    "minimal",
    "low",
    "medium",
    "high",
    "xhigh",
    "max"
   ]
  },
  "reason": {
   "enum": [
    "draft",
    "fork",
    "superseded",
    "stopped",
    "push_cap",
    "unchanged",
    "ignored",
    "no_access",
    "post_refused"
   ]
  },
  "important": {
   "type": "integer",
   "minimum": 0,
   "maximum": 9999
  },
  "nit": {
   "type": "integer",
   "minimum": 0,
   "maximum": 9999
  },
  "pre_existing": {
   "type": "integer",
   "minimum": 0,
   "maximum": 9999
  },
  "cost_usd": {
   "type": "number",
   "minimum": 0,
   "maximum": 100000
  },
  "run": {
   "type": "string",
   "pattern": "^[A-Za-z0-9_.-]{1,64}$"
  },
  "answer": {
   "enum": [
    "help",
    "always",
    "focus",
    "focus_cleared",
    "no_review"
   ]
  },
  "ack": {
   "type": "integer",
   "minimum": 1
  },
  "review": {
   "type": "string",
   "pattern": "^https://github\\.com/[A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}/pull/\\d{1,9}#pullrequestreview-\\d{1,15}$"
  }
 }
}
