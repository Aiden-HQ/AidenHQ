{
 "type": "object",
 "additionalProperties": false,
 "required": [
  "repo",
  "base",
  "branch",
  "expected_tip",
  "files"
 ],
 "properties": {
  "repo": {
   "type": "string",
   "pattern": "^[A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}$"
  },
  "base": {
   "type": "string",
   "pattern": "^[0-9a-f]{40}$"
  },
  "branch": {
   "enum": [
    "aidenhq/deepsec-setup"
   ]
  },
  "expected_tip": {
   "description": "the branch's tip the commit goes on (a 40-character sha), or null for a new branch; the executor's plan checks it"
  },
  "files": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    ".deepsec/INFO.md": { "type": "string", "maxLength": 200000 },
    ".deepsec/deepsec.config.ts": { "type": "string", "maxLength": 200000 },
    ".deepsec/generated-matchers.ts": { "type": "string", "maxLength": 200000 },
    ".deepsec/package.json": { "type": "string", "maxLength": 200000 },
    ".deepsec/package-lock.json": { "type": "string", "maxLength": 2000000 },
    ".deepsec/pnpm-lock.yaml": { "type": "string", "maxLength": 2000000 },
    ".deepsec/yarn.lock": { "type": "string", "maxLength": 2000000 },
    ".deepsec/bun.lock": { "type": "string", "maxLength": 2000000 }
   }
  }
 }
}
