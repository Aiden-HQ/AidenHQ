{
 "type": "object",
 "additionalProperties": false,
 "required": [
  "repo",
  "pr",
  "head",
  "run",
  "finding",
  "comment",
  "verdict",
  "reason"
 ],
 "properties": {
  "repo": {
   "type": "string",
   "pattern": "^[A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}$"
  },
  "pr": {
   "type": "integer",
   "minimum": 1
  },
  "head": {
   "type": "string",
   "pattern": "^[0-9a-f]{40}$"
  },
  "run": {
   "type": "string",
   "pattern": "^[A-Za-z0-9_.-]{1,64}$"
  },
  "finding": {
   "type": "string",
   "pattern": "^[A-Za-z0-9_-]{6,64}$"
  },
  "comment": {
   "type": "integer",
   "minimum": 1
  },
  "verdict": {
   "enum": [
    "dismissed",
    "upheld"
   ]
  },
  "reason": {
   "type": "string",
   "minLength": 1,
   "maxLength": 1500
  }
 }
}
