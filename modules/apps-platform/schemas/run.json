{
  "type": "object", "additionalProperties": false, "required": ["name", "script", "service", "sha"],
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,30}$" }, "script": { "type": "string", "pattern": "^[a-z0-9][a-z0-9:_-]{0,63}$" },
    "service": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,62}$" }, "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
  }
}
