{
  "title": "codehost-github.pr: push these branches, then open (or update) each one's PR.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workspace",
    "only"
  ],
  "properties": {
    "workspace": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9]*-[0-9]+$"
    },
    "only": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repo",
          "branch",
          "sha"
        ],
        "properties": {
          "repo": {
            "type": "string",
            "pattern": "^[\\w.-]+/[\\w.-]+$"
          },
          "branch": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[\\w./-]+$"
          },
          "sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        }
      }
    },
    "text": {
      "title": "the PR's title and body",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "body"
      ],
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 300
        },
        "body": {
          "type": "string",
          "maxLength": 60000
        }
      }
    }
  }
}
