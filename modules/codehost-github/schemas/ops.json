{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A module's grant on codehost-github's operations (contributes: codehost-github.ops). repos: owner/name, owner/* (every repo of owner, and org-wide tokens there) or */* (anything the App covers).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "token": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repos",
        "perms"
      ],
      "properties": {
        "repos": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^([\\w.-]+/([\\w.-]+|\\*)|\\*/\\*)$"
          }
        },
        "perms": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "contents": {
              "enum": [
                "read",
                "write"
              ]
            },
            "metadata": {
              "enum": [
                "read",
                "write"
              ]
            },
            "pull_requests": {
              "enum": [
                "read",
                "write"
              ]
            },
            "issues": {
              "enum": [
                "read",
                "write"
              ]
            },
            "checks": {
              "enum": [
                "read",
                "write"
              ]
            },
            "statuses": {
              "enum": [
                "read",
                "write"
              ]
            },
            "actions": {
              "enum": [
                "read",
                "write"
              ]
            },
            "organization_projects": {
              "enum": [
                "read",
                "write"
              ]
            },
            "administration": {
              "enum": [
                "read",
                "write"
              ]
            },
            "organization_self_hosted_runners": {
              "enum": [
                "read",
                "write"
              ]
            }
          }
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repos"
      ],
      "properties": {
        "repos": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^([\\w.-]+/([\\w.-]+|\\*)|\\*/\\*)$"
          }
        }
      }
    },
    "clone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repos"
      ],
      "properties": {
        "repos": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^([\\w.-]+/([\\w.-]+|\\*)|\\*/\\*)$"
          }
        }
      }
    }
  }
}
