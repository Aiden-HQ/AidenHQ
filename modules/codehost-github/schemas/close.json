{
  "title": "codehost-github.close: close these PRs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "prs"
  ],
  "properties": {
    "prs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "title": "a PR",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repo",
          "number"
        ],
        "properties": {
          "repo": {
            "type": "string",
            "pattern": "^[\\w.-]+/[\\w.-]+$"
          },
          "number": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
