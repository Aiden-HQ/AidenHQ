{
  "type": "object", "additionalProperties": false, "required": ["op", "channel", "by", "token"],
  "properties": {
    "op": { "type": "string", "enum": ["assign", "unassign"] },
    "channel": { "type": "string", "pattern": "^[CG][A-Z0-9]{6,}$" },
    "by": { "type": "string", "pattern": "^[UW][A-Z0-9]{2,}$" },
    "token": { "type": "string", "minLength": 20, "maxLength": 100 },
    "agent": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" }
  }
}
