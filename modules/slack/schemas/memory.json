{
  "type": "object", "additionalProperties": false, "required": ["channel", "note", "base_revision"],
  "properties": {
    "channel": { "type": "string", "pattern": "^[CG][A-Z0-9]{6,}$" },
    "note": { "type": "string", "maxLength": 2048 },
    "base_revision": { "type": "integer", "minimum": 0 },
    "agent": { "type": "string", "maxLength": 100 },
    "provenance": { "type": "string", "maxLength": 100 }
  }
}
