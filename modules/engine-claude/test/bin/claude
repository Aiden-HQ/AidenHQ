#!/usr/bin/env node
// A stand-in Claude Code for the contract kit: streamed input, each message replayed and answered; exits when stdin closes.
import { createInterface } from "node:readline";
const args = process.argv.slice(2);
const say = (e) => console.log(JSON.stringify(e));
say({ type: "system", subtype: "init", session_id: args.includes("--resume") ? args[args.indexOf("--resume") + 1] : "sess-1" });
let first = true;
for await (const line of createInterface({ input: process.stdin })) {
  const text = JSON.parse(line).message.content;
  say({ type: "user", isReplay: true, message: { role: "user", content: text } });
  if (first) await new Promise((r) => setTimeout(r, 800)); // the first turn takes a while: a comment arrives during it
  first = false;
  say({ type: "assistant", message: { content: [{ type: "text", text: `heard: ${text}` }] } });
  say({ type: "result", result: "ok", usage: { input_tokens: 5, output_tokens: 1 } });
}
