#!/usr/bin/env node
// channel-operator's host CLI: the owner's Claude watcher decides one card with this channel's own decision token.
//   modules/channel-operator/bin/decide <card id> approve|reject [--stale]
// It reads its token from the vault ($AIDENHQ_SECRETS_DIR, default ~/.config/aidenhq: channel_operator_token) and its
// operator_decide setting from the compiled config/kernel/modules.json, asks the kernel for the pending cards with fresh
// tokens for this channel (resync), and spends that card's one token. The kernel stamps it `watcher` (`stale:watcher` with
// --stale, a reject that never counts as the owner's veto). No dependencies: Node's own fetch.
import { readFileSync } from "node:fs";
import { homedir } from "node:os";
import { dirname, join, resolve } from "node:path";
import { fileURLToPath } from "node:url";

const usage = "usage: decide <card id> approve|reject [--stale]";
export function parseArgs(argv) {
  const [id, decision, ...rest] = argv;
  if (!id || !/^(A[0-9a-f]{8}|k-[0-9a-f]{16})$/.test(id) || !["approve", "reject"].includes(decision ?? "")) throw new Error(usage);
  const stale = rest.includes("--stale");
  if (rest.some((r) => r !== "--stale")) throw new Error(usage);
  if (stale && decision !== "reject") throw new Error("--stale is only for a reject");
  return { id, decision, stale };
}
/** Whether the setting lets this channel decide the card (standard: not a panel card, not an apply). */
export function allowed(card, setting) {
  return setting === "all" || (setting === "standard" && !card.panel && card.kind !== "apply" && card.kind !== "kernel.apply");
}

export async function decide(argv, { env = process.env, fetch: f = fetch, read = (p) => readFileSync(p, "utf8") } = {}) {
  const { id, decision, stale } = parseArgs(argv);
  const checkout = resolve(dirname(fileURLToPath(import.meta.url)), "../../..");
  const secrets = (env.AIDENHQ_SECRETS_DIR ?? "~/.config/aidenhq").replace(/^~(?=\/|$)/, homedir());
  const token = read(join(secrets, "channel_operator_token")).trim();
  if (!token) throw new Error("channel_operator_token is empty: is channel-operator enabled (instance.yaml modules) and applied?");
  const config = env.AIDENHQ_CONFIG_DIR ? resolve(env.AIDENHQ_CONFIG_DIR) : join(checkout, "config");
  const setting = JSON.parse(read(join(config, "kernel", "modules.json")))?.modules?.["channel-operator"]?.settings?.operator_decide ?? "all";
  const kernel = (env.AIDENHQ_KERNEL_URL ?? "http://10.231.0.1:3130").replace(/\/$/, "");
  const call = async (method, path, body) => {
    const res = await f(`${kernel}${path}`, { method, headers: { authorization: `Bearer ${token}`, "content-type": "application/json" }, ...(body ? { body: JSON.stringify(body) } : {}) });
    const j = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error(`${j?.error?.message ?? `the kernel said ${res.status}`}`);
    return j;
  };
  const { cards = [] } = await call("GET", "/v1/channel/cards?resync=1");
  const card = cards.find((c) => c.id === id);
  if (!card) throw new Error(`no pending card ${id} (decided already, or with the AI reviewer)`);
  if (!allowed(card, setting)) throw new Error(`operator_decide is ${setting}: ${id} is kept for the owner`);
  if (!card.tokens) throw new Error(`the kernel sent no token for ${id}`);
  const r = await call("POST", "/v1/channel/decide", { token: card.tokens[decision], sender: "watcher", ...(stale ? { stale: true } : {}) });
  return `${r.state ?? decision}: ${r.identifier ?? ""} ${r.sentence ?? ""}`.trim();
}

if (process.argv[1] && resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
  decide(process.argv.slice(2)).then((line) => console.log(line), (err) => { console.error(`decide: ${err.message}`); process.exit(1); });
}
