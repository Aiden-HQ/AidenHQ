{
  "title": "board.pages: a module's Fleet page (docs/design/board-ui.md \"Modules\"). Compile adds `module`.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "icon", "order", "connection", "view", "tools"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,30}$", "description": "the page's address, #/fleet/<id>; unique across modules"},
    "title": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9 .&-]{0,30}$", "description": "its name in the sidebar and the page header"},
    "icon": {"enum": ["agents", "apps", "modules", "reviews", "costs", "flow", "tasks", "approvals", "chat", "brief", "bell", "settings", "rocket", "list", "shield"], "description": "one of the board's icons"},
    "order": {"type": "integer", "minimum": 1, "maximum": 999, "description": "its place after the core entries (Agents, Apps, Modules, Reviews), ascending"},
    "connection": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,62}$", "description": "one of this module's own MCP connections: it serves the view and the tools"},
    "view": {"type": "string", "pattern": "^ui://[a-z][a-z0-9-]{0,62}/[a-z0-9][a-z0-9/_.-]{0,100}$", "description": "the view, ui://<this module>/<path>, served by `connection`"},
    "tools": {"type": "array", "maxItems": 20, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"}, "description": "the tools the view calls: read or write tools of `connection`, each named <module>_…"},
    "secret_maps": {
      "type": "array", "maxItems": 2,
      "description": "the board's native Sign-ins panel under the frame: per key Set, Replace or Clear one entry of a JSON-map secret",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["secret", "keys_from", "fields"],
        "properties": {
          "secret": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
          "keys_from": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}(\\.[a-z][a-z0-9_]{0,63})*\\[\\]\\.[a-z][a-z0-9_]{0,63}$"},
          "fields": {
            "type": "array", "minItems": 1, "maxItems": 8,
            "items": {
              "type": "object", "additionalProperties": false, "required": ["name", "label", "kind"],
              "properties": {
                "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$"},
                "label": {"type": "string", "minLength": 1, "maxLength": 40},
                "kind": {"enum": ["text", "password", "key", "totp"]},
                "maxLength": {"type": "integer", "minimum": 1, "maximum": 65536}
              }
            }
          }
        }
      }
    }
  }
}
