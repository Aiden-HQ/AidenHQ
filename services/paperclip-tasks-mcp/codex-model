#!/bin/sh
# Codex for an agent whose routine has its own model and/or reasoning effort (docs/configuration.md, "A model per routine").
# Setup puts them in the routine's env as AIDENHQ_MODEL and AIDENHQ_REASONING_EFFORT, which Paperclip passes to that routine's
# runs; this swaps them in for the agent's own on `codex exec`. Anything else (neither set, --version, ...) runs Codex as is.
# (A computer agent's launcher does the same in services/computer/lib.mjs, routineArgs.)
[ "$1" = exec ] && { [ -n "$AIDENHQ_MODEL" ] || [ -n "$AIDENHQ_REASONING_EFFORT" ]; } || exec codex "$@"
shift
n=$#
set -- "$@" exec
[ -n "$AIDENHQ_MODEL" ] && set -- "$@" --model "$AIDENHQ_MODEL"
[ -n "$AIDENHQ_REASONING_EFFORT" ] && set -- "$@" -c "model_reasoning_effort=\"$AIDENHQ_REASONING_EFFORT\""
while [ "$n" -gt 0 ]; do
  a=$1; shift; n=$((n - 1))
  if [ -n "$AIDENHQ_MODEL" ] && [ "$a" = --model ] && [ "$n" -gt 0 ]; then shift; n=$((n - 1)); continue; fi
  if [ -n "$AIDENHQ_REASONING_EFFORT" ] && [ "$a" = -c ] && [ "$n" -gt 0 ]; then
    case $1 in model_reasoning_effort=*) shift; n=$((n - 1)); continue ;; esac
  fi
  set -- "$@" "$a"
done
exec codex "$@"
