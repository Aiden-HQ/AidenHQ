    lines.push("## Look at these first", "", changed.length ? "Pages whose pictures changed, biggest change first (before|after is the comparison picture, diff the pixel diff):" : `No page changed by ${CHANGED_PCT}% or more of its pixels.`, "");
    for (const { p, shots } of changed) lines.push(`- ${p.path}${p.palette ? ` [${p.palette}]` : ""}`, ...shots.map((s) => `  - ${s.width}px ${s.mode}: ${s.compare.diffPct}% changed · before|after: ${s.compare.compare ?? "–"} · diff: ${s.compare.diff}`));
    lines.push("");
  }
  if (notes.length) lines.push(`## Notes (${notes.length}): not failures`, "", ...notes.map((n) => `- ${n}`), "");
  lines.push("## Pages", "");
  for (const p of report.pages) {
    const shows = map?.find((m) => m.path === p.path)?.shows;
    lines.push(`### ${p.path}${p.palette ? ` [${p.palette}]` : ""}${typeof shows === "string" && shows ? ` — ${shows}` : ""}`, "");
    if (p.vitals) lines.push(`Vitals: LCP ${p.vitals.lcp_ms ?? "–"} ms · CLS ${p.vitals.cls ?? "–"} · FCP ${p.vitals.fcp_ms ?? "–"} ms · TTFB ${p.vitals.ttfb_ms ?? "–"} ms`);
    for (const [mode, a] of Object.entries(p.a11y)) lines.push(`Accessibility (${mode}): ${a.violations.length ? a.violations.map((v) => `${v.id} ${v.impact} ×${v.nodes}`).join(", ") : "no violations"}${a.incomplete.length ? `; check by eye: ${a.incomplete.join(", ")}` : ""}`);
    if (p.system) lines.push(`One system (not a failure; fewer is better): ${p.system.buttonShapes} button shapes · ${p.system.radii} border radii · ${p.system.cardStyles} card styles · ${p.system.headingSizes} heading sizes · ${p.system.deepBoxes} boxes nested more than 2 deep`);
    if (p.copy?.length) lines.push("Copy (not a failure; fix what reads wrong):", ...p.copy.map((c) => `- ${c}`));
    const small = Object.entries(p.layout).filter(([k, l]) => k.startsWith(String(Math.min(...widths))) && l.small).map(([, l]) => l.small)[0];
    if (small) lines.push(`Phone: ${small} controls are 24-43px tall (44px is the phone rule; check the main ones).`);
    lines.push("", "Screenshots (open each one):", ...p.shots.map((s) => `- ${s.name}${s.compare ? ` · before|after: ${s.compare.compare ?? "–"} · diff: ${s.compare.diff} (${s.compare.diffResult})` : ""}`), "");
  }
  if (report.routesNote) lines.push(`Routes: ${report.routesNote}`, "");
  if (report.routes.length) lines.push("## Routes (brand, click, Back, Forward, reload)", "", ...report.routes.map((r) => `- ${r.from} ${r.link ? `link "${r.link}" (${r.to})` : r.what}: ${r.skipped ?? (r.problems.join("; ") || (r.link && !r.samePage ? "renders" : "acts"))}`), ...(report.routesCut ? ["- (more kinds of link than the 12 checked: review the rest with --paths on their pages)"] : []), "");
  lines.push("Automated checks find maybe a third of what matters. Now look at every screenshot against the review checklist.");
  writeFileSync(join(out, "report.md"), lines.join("\n"));
  writeFileSync(join(out, "report.json"), JSON.stringify({ ...report, blocking: introduced, preexisting, notes }, null, 2));
  console.log(`${join(out, "report.md")}: ${introduced.length} blocking, ${preexisting.length} already on this base, ${report.pages.reduce((n, p) => n + p.shots.length, 0)} screenshots, ${notes.length} notes`);
  process.exit(introduced.length ? 1 : 0);
}
(!palettes.length && !args.includes("--no-routes") ? routeChecks() : Promise.resolve()).then(finish, (e) => { console.error(`ui-review: ${e.stack || e.message}`); process.exit(2); });
