#!/usr/bin/env node
// ui-review: one command for a design review of a running web app, built on agent-browser (its Chrome, its embedded axe-core
// and its web-vitals). For each path it takes screenshots at phone, tablet and desktop widths in light and dark, runs an
// accessibility audit (WCAG 2.2 AA) in each mode, measures web vitals, collects page and console errors and failed loads,
// and checks the layout (horizontal overflow, small tap targets, tiny text). With --baseline <dir of an earlier run> it also writes pixel diffs and
// before|after pictures, and report.md opens with "Look at these first": the pages that changed, biggest change first. Both runs
// pin the page's clock to one instant (the baseline's, when there is one) so "2m ago" reads the same in both pictures.
// Writes <out>/report.md (read this first) and report.json; exits 1 when it finds blocking problems.
//
//   ui-review http://127.0.0.1:8080 --out review                  (the app's feature-map.json, or "/" without one)
//   ui-review http://127.0.0.1:8080 --paths /,/items --out review  (an explicit list wins over the map)
//   ui-review http://127.0.0.1:8080 --paths / --out after --baseline before
//   ui-review http://127.0.0.1:8080 --paths /catalog --palettes neutral,warm,contrast,data   (the app starter's catalog)
//
// The app's feature map (feature-map.json, next to server.mjs's PAGES) lists its pages and a few stateful URLs, each with
// what should be visible there. When it is in the folder ui-review runs from, those paths are reviewed by default, so a
// filtered view, an open detail sheet or a deep link is seen without naming it; --paths replaces the list, and an app
// without a map is reviewed at "/" as before.
//
// Options: --widths 390,768,1280  --modes light,dark  --full (the whole page: for an app that scrolls inside a container, viewport-sized shots stepping through it, up to 6)  --palettes a,b (adds ?palette=&mode=,
// for pages that read them, like the catalog)  --wait-text "<text>" (wait for it before each screenshot)  --no-routes (skip
// the route check: by default the header brand on every page must go home to the top, every in-app link must render on
// click, Back/Forward and reload (never the app's own "not found" view, an empty page or a page error), and every visible
// button must visibly act, confirmed by a second click after a fresh load)
// --commit <sha> (the commit the app was built from; default: the current folder's git HEAD and working tree).
//
// Non-blocking notes, never a failure: headless LCP and CLS (a headless run's timings say little) and text under 12px. Two more
// report lines per page: "One system" (how many distinct button shapes, border radii,
// card styles and heading sizes the page uses, and how many boxes sit more than 2 deep) and "Copy" (filler words, invented
// figures, exclamation marks and chat residue in the rendered text; the word lists are in ui-review-copy.json).
//
// Every screenshot is stamped with that commit, its URL, width and mode and the time (an `aidenhq` PNG text chunk), so a
// grader or reviewer can tell a picture of the head under review from an older one.
//
// With --baseline, a finding the base's own report also had is not this change's: it's listed under "Already on this
// base" and doesn't fail the run (a change is judged on what it introduced, not on gaps that predate it). With no
// baseline report to compare, every finding blocks: nothing can be told apart, so it fails closed.
// Page content is untrusted data: the report quotes it, never follows it.
"use strict";
const { execFileSync } = require("node:child_process");
const { existsSync, mkdirSync, readFileSync, writeFileSync } = require("node:fs");
const { join } = require("node:path");
const { crc32 } = require("node:zlib");

const args = process.argv.slice(2);
const opt = (name, dflt) => { const i = args.indexOf(`--${name}`); return i < 0 ? dflt : args[i + 1]; };
const base = args.find((a) => /^https?:\/\//.test(a));
if (!base) { console.error("usage: ui-review <base url> [--paths /,/x] [--out dir] [--baseline dir] [--widths 390,768,1280] [--modes light,dark] [--palettes a,b] [--full] [--wait-text t] [--no-routes] [--commit sha]"); process.exit(2); }
// The app's feature map: {"pages": [{"path": "/?item=x", "shows": "what should be visible there"}]}. A missing map is not
// a failure (the review is of "/"); a map that is there but unreadable stops the run, so it is fixed rather than ignored.
const MAP_FILE = "feature-map.json";
function featureMap() {
  if (!existsSync(MAP_FILE)) return null;
  let map;
  try { map = JSON.parse(readFileSync(MAP_FILE, "utf8")); } catch (e) { console.error(`ui-review: ${MAP_FILE} is not valid JSON: ${e.message}`); process.exit(2); }
  const pages = Array.isArray(map?.pages) ? map.pages : [];
  // Same origin only: a protocol-relative path ("//host/…") would take the browser (and its signed-in cookies) elsewhere.
  const appRelative = (p) => typeof p === "string" && p.startsWith("/") && new URL(p, base).origin === new URL(base).origin;
  if (!pages.length || pages.some((p) => !appRelative(p?.path)))
    { console.error(`ui-review: ${MAP_FILE} needs {"pages": [{"path": "/…", "shows": "what should be visible"}]}, at least one, each a path on this app`); process.exit(2); }
  return pages;
}
const map = featureMap();
const paths = (opt("paths", null) ?? (map ? map.map((p) => p.path).join(",") : "/")).split(",");
const out = opt("out", "ui-review");
const baseline = opt("baseline", null);
const widths = opt("widths", "390,768,1280").split(",").map(Number);
const modes = opt("modes", "light,dark").split(",");
const palettes = opt("palettes", "").split(",").filter(Boolean);
const waitText = opt("wait-text", null);
const full = args.includes("--full");
// What the screenshots show: --commit (a checkout without git), else this folder's git HEAD and the tree of its working files
// (uncommitted changes included, as aidenhq-browse records it).
function source() {
  if (opt("commit", "")) return { commit: opt("commit") };
  try {
    const git = (a, env) => execFileSync("git", a, { encoding: "utf8", stdio: ["ignore", "pipe", "ignore"], env: { ...process.env, ...env } }).trim();
    const commit = git(["rev-parse", "HEAD"]);
    const index = join(require("node:fs").mkdtempSync(join(require("node:os").tmpdir(), "ui-review-tree-")), "index");
    git(["read-tree", "HEAD"], { GIT_INDEX_FILE: index });
    git(["add", "-A", "--", git(["rev-parse", "--show-toplevel"])], { GIT_INDEX_FILE: index });
    return { commit, tree: git(["write-tree"], { GIT_INDEX_FILE: index }) };
  } catch {
    return {};
  }
}
const at = source();
mkdirSync(out, { recursive: true });
// One instant for the page's clock: the baseline's when it has one, else now. Both runs of a before|after pair then show "2m ago"
// alike. agent-browser 0.41.2 has no clock command: an init script (env var, so every session of this run gets it) pins Date.
const baselineReport = baseline && existsSync(join(baseline, "report.json")) ? JSON.parse(readFileSync(join(baseline, "report.json"), "utf8")) : null;
const frozenAt = baselineReport?.frozenAt ?? new Date().toISOString();
const freezeFile = join(out, ".freeze-time.js");
writeFileSync(freezeFile, `(() => { const T = ${Date.parse(frozenAt)}, D = Date; window.Date = class extends D { constructor(...a) { a.length ? super(...a) : super(T); } static now() { return T; } }; })();`);
process.env.AGENT_BROWSER_INIT_SCRIPTS = freezeFile;

/** A PNG with an `aidenhq` text chunk after IHDR: the capture's stamp (JSON, ASCII-escaped). */
function stampPng(file, stamp) {
  const buf = readFileSync(file);
  if (buf.length < 33 || buf.readUInt32BE(0) !== 0x89504e47) return;
  const json = JSON.stringify(stamp).replace(/[\u007f-\uffff]/g, (c) => `\\u${c.charCodeAt(0).toString(16).padStart(4, "0")}`);
  const body = Buffer.concat([Buffer.from("tEXtaidenhq\0", "latin1"), Buffer.from(json, "latin1")]);
  const len = Buffer.alloc(4), crc = Buffer.alloc(4);
  len.writeUInt32BE(body.length - 4);
  crc.writeUInt32BE(crc32(body));
  writeFileSync(file, Buffer.concat([buf.subarray(0, 33), len, body, crc, buf.subarray(33)]));
}

// Reads the rendered page for the two non-blocking checks: the distinct styles in use (as keys), nesting depth, and the visible text.
const SYSTEM = `/*system*/(() => {
  const visible = (e) => { const r = e.getBoundingClientRect(), s = getComputedStyle(e); return r.width > 0 && r.height > 0 && s.visibility !== "hidden" && !e.closest("[hidden],dialog:not([open])"); };
  const all = [...document.body.querySelectorAll("*")].filter(visible), cs = new Map(all.map((e) => [e, getComputedStyle(e)]));
  const clear = (c) => c === "rgba(0, 0, 0, 0)" || c === "transparent";
  const box = (e) => { const s = cs.get(e), p = e.parentElement && cs.get(e.parentElement); return parseFloat(s.borderTopWidth) > 0 || s.boxShadow !== "none" || (!clear(s.backgroundColor) && (!p || p.backgroundColor !== s.backgroundColor)); };
  const boxes = all.filter(box), isBox = new Set(boxes);
  const round = (r) => /%|999/.test(r) || parseFloat(r) > 50;
  const set = (list, key) => [...new Set(list.map(key))];
  const texts = [...document.body.querySelectorAll("h1,h2,h3,h4,h5,h6,p,li,td,th,label,button,a,summary,figcaption,[role=button],[role=heading]")].filter(visible).map((e) => e.innerText.trim().replace(/\\s+/g, " ")).filter(Boolean).slice(0, 400);
  return JSON.stringify({
    buttons: set(all.filter((e) => e.matches("button,[role=button],[data-slot=button]")), (e) => cs.get(e).borderRadius + " / " + Math.round(e.getBoundingClientRect().height) + "px"),
    radii: set(boxes.filter((e) => !round(cs.get(e).borderRadius) && parseFloat(cs.get(e).borderRadius) > 0), (e) => cs.get(e).borderRadius),
    cards: set(all.filter((e) => e.matches("[data-slot=card],[class*=card]")), (e) => { const s = cs.get(e); return [s.borderRadius, s.borderTopWidth, s.boxShadow === "none" ? "flat" : "shadow", s.backgroundColor].join(" "); }),
    headings: set(all.filter((e) => e.matches("h1,h2,h3,h4,h5,h6,[role=heading]")), (e) => cs.get(e).fontSize),
    nested: boxes.filter((e) => { let n = 0; for (let p = e.parentElement; p; p = p.parentElement) if (isBox.has(p)) n++; return n > 2; }).length,
    texts,
  });
})()`;

// The copy check's word lists live in one data file next to this script: filler and chat words, and patterns for invented figures.
const COPY = JSON.parse(readFileSync(join(__dirname, "ui-review-copy.json"), "utf8"));
const copyFindings = (texts) => {
  const hits = [], note = (what, t) => hits.push(`${what}: "${t.slice(0, 80)}"`);
  const has = (list, t) => list.find((w) => new RegExp(`\\b${w}\\b`, "i").test(t));
  for (const t of texts) {
    const f = has(COPY.filler, t), c = COPY.chat.find((w) => t.toLowerCase().includes(w.toLowerCase())), n = COPY.figures.find((re) => new RegExp(re, "i").test(t));
    if (f) note(`filler word "${f}"`, t); if (c) note("chat residue", t); if (n) note("invented-looking figure", t); if (t.includes("!")) note("exclamation mark", t);
  }
  return [...new Set(hits)].slice(0, 12);
};

const AB = process.env.AGENT_BROWSER || "agent-browser";
// The image's pinned Chrome, when the shell lost the image's environment (else agent-browser downloads a Chrome of its own).
if (!process.env.AGENT_BROWSER_EXECUTABLE_PATH && existsSync("/opt/chrome/chrome")) process.env.AGENT_BROWSER_EXECUTABLE_PATH = "/opt/chrome/chrome";
const ab = (...a) => execFileSync(AB, a, { encoding: "utf8", maxBuffer: 64 << 20, stdio: ["ignore", "pipe", "pipe"], timeout: 60000 });
const abJson = (...a) => { const r = JSON.parse(ab(...a, "--json")); if (!r.success) throw new Error(r.error || `${a[0]} failed`); return r.data; };
const run = (expr) => abJson("eval", expr).result;
const firstLine = (e) => String(e.stderr || e.message).split("\n")[0].slice(0, 160);

// Readiness, never network idle (a page that polls or streams never idles): the page is done when it has loaded, its fonts are
// in, no fetch or XHR is in flight and no new resource or DOM change has arrived for 200 ms, at most 1.5 s. Every wait in
// this script is this one.
const READY = `/*routes:ready*/(() => new Promise((done) => {
  if (!window.__uiReview) {
    const u = (window.__uiReview = { pending: 0, started: 0, changed: false }), end = () => { u.pending--; };
    const f = window.fetch;
    window.fetch = function (...a) { u.pending++; u.started++; const p = f.apply(this, a); p.then(end, end); return p; };
    new MutationObserver(() => { window.__uiReview.changed = true; }).observe(document, { subtree: true, childList: true, attributes: true, characterData: true });
    const send = XMLHttpRequest.prototype.send;
    XMLHttpRequest.prototype.send = function (...a) { u.pending++; u.started++; this.addEventListener("loadend", end, { once: true }); return send.apply(this, a); };
  }
  const t0 = performance.now();
  let seen = -1, quiet = t0;
  const tick = () => {
    const now = performance.now(), n = performance.getEntriesByType("resource").length;
    if (n !== seen || window.__uiReview.changed || window.__uiReview.pending > 0 || document.readyState !== "complete" || document.fonts.status === "loading") { seen = n; quiet = now; window.__uiReview.changed = false; }
    if (now - quiet >= 200 || now - t0 >= 1500) done("ready"); else setTimeout(tick, 25);
  };
  tick();
}))()`;
/** Wait for the page to be ready (see READY); a click that replaced the document gets one more wait. Never throws. */
function settleMain() {
  try { run(READY); } catch { try { ab("wait", "--load", "domcontentloaded"); run(READY); } catch {} }
}

// Layout checks in the page: horizontal page scroll, text under 12px, and how many controls are under our 44px phone rule
// (axe's target-size covers the WCAG 24px floor, with its spacing exception).
const LAYOUT = `(() => {
  const vw = document.documentElement.clientWidth, sel = (e) => e.id ? "#" + e.id : e.tagName.toLowerCase() + (e.className && typeof e.className === "string" ? "." + e.className.trim().split(/\\s+/).slice(0, 2).join(".") : "");
  const visible = (e) => { const r = e.getBoundingClientRect(), s = getComputedStyle(e); return r.width > 0 && r.height > 0 && s.visibility !== "hidden" && !e.closest("[hidden],dialog:not([open])"); };
  const overflow = document.documentElement.scrollWidth - vw;
  const wide = overflow > 1 ? [...document.querySelectorAll("body *")].filter((e) => visible(e) && e.getBoundingClientRect().right > vw + 1 && !e.closest(".table-wrap,.board,.tabs,[data-slot=table-container],[style*=overflow]")).slice(0, 5).map(sel) : [];
  const targets = [...document.querySelectorAll("a[href],button,input:not([type=hidden]),select,textarea,[role=button],[role=tab],[role=option]")].filter(visible).map((e) => { const r = e.getBoundingClientRect(); return { e, h: Math.round(r.height), w: Math.round(r.width), inline: e.tagName === "A" && getComputedStyle(e).display === "inline" }; });
  const small = targets.filter((t) => !t.inline && t.h >= 24 && t.h < 44 && t.w >= 24).length;
  const texts = [...document.querySelectorAll("body *")].filter((e) => visible(e) && [...e.childNodes].some((n) => n.nodeType === 3 && n.textContent.trim()) && parseFloat(getComputedStyle(e).fontSize) < 12).slice(0, 5).map(sel);
  const failed = performance.getEntriesByType("resource").filter((r) => r.responseStatus >= 400).map((r) => r.responseStatus + " " + r.name).slice(0, 5);
  return JSON.stringify({ overflow: Math.max(0, overflow), wide, small, tinyText: texts, failed });
})()`;

// The app's main scrolling element: the largest visible element that scrolls inside the page (overflow auto/scroll with more
// content than room), as a board or dashboard does in its shell. Null when the page itself scrolls.
const SCROLLER = `/*scroller*/(() => {
  document.querySelectorAll("[data-ui-review-scroller]").forEach((e) => e.removeAttribute("data-ui-review-scroller"));
  let best = null, area = 0;
  for (const e of document.body.querySelectorAll("*")) {
    const s = getComputedStyle(e), r = e.getBoundingClientRect();
    if (!/auto|scroll/.test(s.overflowY) || e.scrollHeight <= e.clientHeight + 1 || r.width <= 0 || r.height <= 0 || s.visibility === "hidden") continue;
    if (r.width * r.height > area) { best = e; area = r.width * r.height; }
  }
  if (!best || area < 0.25 * innerWidth * innerHeight) return "null";
  best.setAttribute("data-ui-review-scroller", "");
  return JSON.stringify({ height: best.scrollHeight, view: best.clientHeight });
})()`;
const SCROLL_TO = (top) => `/*scroll-to*/(() => { const e = document.querySelector("[data-ui-review-scroller]"); if (e) e.scrollTop = ${top}; return "ok"; })()`;
const MAX_STEPS = 6;
/** Screenshots of one page state: one shot, or with --full the whole page (an inner scroller: viewport-sized steps through it). Returns the file names. */
function capture(slug, w, mode, url) {
  const stamp = (name) => stampPng(join(out, name), { ...at, url, width: w, mode, takenAt: new Date().toISOString() });
  const scroller = full ? JSON.parse(run(SCROLLER)) : null;
  if (!scroller) {
    const name = `${slug}-${w}-${mode}.png`;
    ab("screenshot", join(out, name), ...(full ? ["--full"] : []));
    stamp(name);
    return [name];
  }
  const names = [], steps = Math.min(MAX_STEPS, Math.ceil(scroller.height / scroller.view));
  for (let i = 0; i < steps; i++) {
    run(SCROLL_TO(i * scroller.view));
    ab("wait", "150");
    const name = `${slug}-${w}-${mode}${i ? `-s${i + 1}` : ""}.png`;
    ab("screenshot", join(out, name));
    stamp(name);
    names.push(name);
  }
  run(SCROLL_TO(0));
  return names;
}

function compare(name) {
  const before = join(baseline, name), after = join(out, name);
  if (!existsSync(before)) return null;
  const r = { diff: `diff-${name}`, compare: `compare-${name}` };
  try {
    const lines = ab("diff", "screenshot", "--baseline", before, "-o", join(out, r.diff)).trim().split("\n");
    r.diffResult = lines[0].replace(/^\W+/, "");
    const px = /(\d+) different \/ (\d+) total/.exec(lines.join("\n"));
    if (px) r.diffPct = Math.round((1e4 * Number(px[1])) / Number(px[2])) / 100;
  } catch (e) { r.diffResult = `diff failed: ${String(e.stderr || e.message).split("\n")[0]}`; }
  try {
    execFileSync("ffmpeg", ["-loglevel", "error", "-y", "-i", before, "-i", after, "-filter_complex", "[0][1]scale2ref=oh*mdar:ih[a][b];[a]pad=iw+16:ih:0:0:white[a2];[a2][b]hstack", join(out, r.compare)], { stdio: "ignore" });
  } catch { delete r.compare; }
  return r;
}

// A browser left running by an earlier run would keep that run's pinned clock: start this run's browser afresh.
try { ab("close"); } catch {}
const report = { base, at: new Date().toISOString(), frozenAt, featureMap: map, pages: [] };
const blocking = [];
const notes = []; // not failures: what a headless run can't judge (LCP, CLS) and what reads small
const variants = palettes.length ? palettes : [null];
for (const path of paths) for (const palette of variants) {
  const slug = (path === "/" ? "home" : path.replace(/[^a-z0-9]+/gi, "-").replace(/^-+|-+$/g, "") || "home").slice(0, 40) + (palette ? `-${palette}` : "");
  const page = { path, palette, slug, shots: [], a11y: {}, layout: {}, vitals: null, errors: [] };
  const where = `${path}${palette ? ` [${palette}]` : ""}`;
  report.pages.push(page);
  for (const mode of modes) {
    let url = path === "/" ? base : new URL(path, base).href; // "/" is the base URL itself (it may be a page)
    if (palette) { const u = new URL(url); u.searchParams.set("palette", palette); u.searchParams.set("mode", mode); url = u.href; }
    for (const w of [...widths].sort((a, b) => b - a)) {
      // A page that fails is that page's finding; the run goes on with the next.
      try {
      ab("set", "viewport", String(w), w < 600 ? "844" : "900");
      ab("set", "media", mode);
      ab("open", "about:blank");
      ab("open", url);
      settleMain();
      if (waitText) ab("wait", "--text", waitText);
      for (const name of capture(slug, w, mode, url)) {
        const shot = { name, width: w, mode };
        if (baseline) shot.compare = compare(name);
        page.shots.push(shot);
      }
      const lay = JSON.parse(run(LAYOUT));
      page.layout[`${w}-${mode}`] = lay;
      if (lay.overflow > 1) blocking.push(`${where} ${w}px ${mode}: page scrolls sideways by ${lay.overflow}px (${lay.wide.join(", ") || "element not found"})`);
      if (lay.failed.length && w === Math.max(...widths)) blocking.push(`${where} ${mode}: failed loads: ${lay.failed.join(", ")}`);
      if (lay.tinyText.length) notes.push(`${where} ${w}px ${mode}: text under 12px: ${lay.tinyText.join(", ")}`);
      if (w === Math.max(...widths)) {
        const a = abJson("a11y", "--tags", "wcag2a,wcag2aa,wcag21a,wcag21aa,wcag22aa");
        page.a11y[mode] = { violations: a.violations.map((v) => ({ id: v.id, impact: v.impact, help: v.help, nodes: v.nodeCount, targets: v.nodes.slice(0, 5).map((n) => n.target.join(" ")) })), incomplete: a.incomplete.map((v) => v.id) };
        for (const v of a.violations) if (v.impact === "serious" || v.impact === "critical") blocking.push(`${where} ${mode}: axe ${v.id} (${v.impact}, ${v.nodeCount}x): ${v.help} at ${v.nodes.slice(0, 3).map((n) => n.target.join(" ")).join("; ")}`);
        if (mode === modes[0]) {
          try {
            const sys = JSON.parse(run(SYSTEM));
            page.system = { buttonShapes: sys.buttons.length, radii: sys.radii.length, cardStyles: sys.cards.length, headingSizes: sys.headings.length, deepBoxes: sys.nested };
            page.copy = copyFindings(sys.texts);
          } catch (e) { page.system = null; page.copy = [`not checked: ${String(e.message).split("\n")[0]}`]; }
          try {
            const vt = abJson("vitals", url);
            page.vitals = { lcp_ms: vt.lcp?.startTime ?? null, cls: vt.cls?.score ?? null, fcp_ms: vt.fcp ?? null, ttfb_ms: vt.ttfb ?? null, inp_ms: vt.inp ?? null };
            if ((page.vitals.lcp_ms ?? 0) > 2500) notes.push(`${path}: LCP ${Math.round(page.vitals.lcp_ms)} ms (over 2.5 s; a headless run's timing)`);
            if ((page.vitals.cls ?? 0) > 0.1) notes.push(`${path}: layout shift CLS ${page.vitals.cls} (over 0.1; look at the page loading)`);
          } catch (e) { notes.push(`${path}: vitals not measured: ${firstLine(e)}`); }
        }
        const consoleErrors = abJson("console").messages.filter((m) => m.type === "error").map((m) => `console: ${m.text}`);
        ab("console", "--clear");
        const errs = [ab("errors").trim(), ...consoleErrors].filter(Boolean).join("\n");
        if (errs) { page.errors.push(errs.slice(0, 2000)); blocking.push(`${where} ${mode}: page errors: ${errs.split("\n")[0].slice(0, 200)}`); }
        ab("errors", "--clear");
      }
      } catch (e) { blocking.push(`${where} ${w}px ${mode}: could not be reviewed: ${firstLine(e)}`); }
    }
  }
}

// Routes, once, at the widest width in the first mode:
// - the header brand on every reviewed page goes to / with no query, at the top (checked on "/" too, from the foot of
//   the page, so a brand that looks clickable and does nothing fails);
// - every link on the reviewed pages to another page of the app is clicked, and that page must render on the click,
//   again after Back and Forward, and on a reload (answering under 400 and showing what the click showed). A URL that
//   changes while the page stays the same is the commonest navigation bug in apps; one link per kind (its path and
//   query names: ten "?item=" rows are one check), up to 12, the navigation's first;
// - every visible link to the page it is on (a nav "Home" on "/", say) must visibly act too: the page is scrolled to
//   its foot first, and the link must move the address, the scroll or the page. ROUTE_LINKS skips these, so they get
//   their own pass;
