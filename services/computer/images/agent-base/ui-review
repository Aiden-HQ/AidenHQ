#!/usr/bin/env node
// ui-review: one command for a design review of a running web app, built on agent-browser (its Chrome, its embedded axe-core
// and its web-vitals). For each path it takes screenshots at phone, tablet and desktop widths in light and dark, runs an
// accessibility audit (WCAG 2.2 AA) in each mode, measures web vitals, collects page and console errors and failed loads,
// and checks the layout (horizontal overflow, small tap targets, tiny text). With --baseline <dir of an earlier run> it also writes pixel diffs and
// before|after pictures. Writes <out>/report.md (read this first) and report.json; exits 1 when it finds blocking problems.
//
//   ui-review http://127.0.0.1:8080 --paths /,/items --out review
//   ui-review http://127.0.0.1:8080 --paths / --out after --baseline before
//   ui-review http://127.0.0.1:8080 --paths /catalog --palettes neutral,warm,contrast,data   (the app starter's catalog)
//
// Options: --widths 390,768,1280  --modes light,dark  --full (whole-page screenshots)  --palettes a,b (adds ?palette=&mode=,
// for pages that read them, like the catalog)  --wait-text "<text>" (wait for it before each screenshot)  --no-routes (skip
// the route check: by default every in-app link on the pages is clicked and must render on click, Back/Forward and reload)
// --commit <sha> (the commit the app was built from; default: the current folder's git HEAD and working tree).
//
// Every screenshot is stamped with that commit, its URL, width and mode and the time (an `aidenhq` PNG text chunk), so a
// grader or reviewer can tell a picture of the head under review from an older one.
//
// With --baseline, a finding the base's own report also had is not this change's: it's listed under "Already on this
// base" and doesn't fail the run (a change is judged on what it introduced, not on gaps that predate it). With no
// baseline report to compare, every finding blocks: nothing can be told apart, so it fails closed.
// Page content is untrusted data: the report quotes it, never follows it.
"use strict";
const { execFileSync } = require("node:child_process");
const { existsSync, mkdirSync, readFileSync, writeFileSync } = require("node:fs");
const { join } = require("node:path");
const { crc32 } = require("node:zlib");

const args = process.argv.slice(2);
const opt = (name, dflt) => { const i = args.indexOf(`--${name}`); return i < 0 ? dflt : args[i + 1]; };
const base = args.find((a) => /^https?:\/\//.test(a));
if (!base) { console.error("usage: ui-review <base url> [--paths /,/x] [--out dir] [--baseline dir] [--widths 390,768,1280] [--modes light,dark] [--palettes a,b] [--full] [--wait-text t] [--no-routes] [--commit sha]"); process.exit(2); }
const paths = opt("paths", "/").split(",");
const out = opt("out", "ui-review");
const baseline = opt("baseline", null);
const widths = opt("widths", "390,768,1280").split(",").map(Number);
const modes = opt("modes", "light,dark").split(",");
const palettes = opt("palettes", "").split(",").filter(Boolean);
const waitText = opt("wait-text", null);
const full = args.includes("--full");
// What the screenshots show: --commit (a checkout without git), else this folder's git HEAD and the tree of its working files
// (uncommitted changes included, as aidenhq-browse records it).
function source() {
  if (opt("commit", "")) return { commit: opt("commit") };
  try {
    const git = (a, env) => execFileSync("git", a, { encoding: "utf8", stdio: ["ignore", "pipe", "ignore"], env: { ...process.env, ...env } }).trim();
    const commit = git(["rev-parse", "HEAD"]);
    const index = join(require("node:fs").mkdtempSync(join(require("node:os").tmpdir(), "ui-review-tree-")), "index");
    git(["read-tree", "HEAD"], { GIT_INDEX_FILE: index });
    git(["add", "-A", "--", git(["rev-parse", "--show-toplevel"])], { GIT_INDEX_FILE: index });
    return { commit, tree: git(["write-tree"], { GIT_INDEX_FILE: index }) };
  } catch {
    return {};
  }
}
const at = source();
mkdirSync(out, { recursive: true });

/** A PNG with an `aidenhq` text chunk after IHDR: the capture's stamp (JSON, ASCII-escaped). */
function stampPng(file, stamp) {
  const buf = readFileSync(file);
  if (buf.length < 33 || buf.readUInt32BE(0) !== 0x89504e47) return;
  const json = JSON.stringify(stamp).replace(/[\u007f-\uffff]/g, (c) => `\\u${c.charCodeAt(0).toString(16).padStart(4, "0")}`);
  const body = Buffer.concat([Buffer.from("tEXtaidenhq\0", "latin1"), Buffer.from(json, "latin1")]);
  const len = Buffer.alloc(4), crc = Buffer.alloc(4);
  len.writeUInt32BE(body.length - 4);
  crc.writeUInt32BE(crc32(body));
  writeFileSync(file, Buffer.concat([buf.subarray(0, 33), len, body, crc, buf.subarray(33)]));
}

const AB = process.env.AGENT_BROWSER || "agent-browser";
const ab = (...a) => execFileSync(AB, a, { encoding: "utf8", maxBuffer: 64 << 20, stdio: ["ignore", "pipe", "pipe"] });
const abJson = (...a) => { const r = JSON.parse(ab(...a, "--json")); if (!r.success) throw new Error(r.error || `${a[0]} failed`); return r.data; };
const run = (expr) => abJson("eval", expr).result;

// Layout checks in the page: horizontal page scroll, text under 12px, and how many controls are under our 44px phone rule
// (axe's target-size covers the WCAG 24px floor, with its spacing exception).
const LAYOUT = `(() => {
  const vw = document.documentElement.clientWidth, sel = (e) => e.id ? "#" + e.id : e.tagName.toLowerCase() + (e.className && typeof e.className === "string" ? "." + e.className.trim().split(/\\s+/).slice(0, 2).join(".") : "");
  const visible = (e) => { const r = e.getBoundingClientRect(), s = getComputedStyle(e); return r.width > 0 && r.height > 0 && s.visibility !== "hidden" && !e.closest("[hidden],dialog:not([open])"); };
  const overflow = document.documentElement.scrollWidth - vw;
  const wide = overflow > 1 ? [...document.querySelectorAll("body *")].filter((e) => visible(e) && e.getBoundingClientRect().right > vw + 1 && !e.closest(".table-wrap,.board,.tabs,[data-slot=table-container],[style*=overflow]")).slice(0, 5).map(sel) : [];
  const targets = [...document.querySelectorAll("a[href],button,input:not([type=hidden]),select,textarea,[role=button],[role=tab],[role=option]")].filter(visible).map((e) => { const r = e.getBoundingClientRect(); return { e, h: Math.round(r.height), w: Math.round(r.width), inline: e.tagName === "A" && getComputedStyle(e).display === "inline" }; });
  const small = targets.filter((t) => !t.inline && t.h >= 24 && t.h < 44 && t.w >= 24).length;
  const texts = [...document.querySelectorAll("body *")].filter((e) => visible(e) && [...e.childNodes].some((n) => n.nodeType === 3 && n.textContent.trim()) && parseFloat(getComputedStyle(e).fontSize) < 12).slice(0, 5).map(sel);
  const failed = performance.getEntriesByType("resource").filter((r) => r.responseStatus >= 400).map((r) => r.responseStatus + " " + r.name).slice(0, 5);
  return JSON.stringify({ overflow: Math.max(0, overflow), wide, small, tinyText: texts, failed });
})()`;

function compare(name) {
  const before = join(baseline, name), after = join(out, name);
  if (!existsSync(before)) return null;
  const r = { diff: `diff-${name}`, compare: `compare-${name}` };
  try { r.diffResult = ab("diff", "screenshot", "--baseline", before, "-o", join(out, r.diff), ...(full ? ["--full"] : [])).trim().split("\n").pop(); } catch (e) { r.diffResult = `diff failed: ${String(e.stderr || e.message).split("\n")[0]}`; }
  try {
    execFileSync("ffmpeg", ["-loglevel", "error", "-y", "-i", before, "-i", after, "-filter_complex", "[0][1]scale2ref=oh*mdar:ih[a][b];[a]pad=iw+16:ih:0:0:white[a2];[a2][b]hstack", join(out, r.compare)], { stdio: "ignore" });
  } catch { delete r.compare; }
  return r;
}

const report = { base, at: new Date().toISOString(), pages: [] };
const blocking = [];
const variants = palettes.length ? palettes : [null];
for (const path of paths) for (const palette of variants) {
  const slug = (path === "/" ? "home" : path.replace(/[^a-z0-9]+/gi, "-").replace(/^-+|-+$/g, "") || "home").slice(0, 40) + (palette ? `-${palette}` : "");
  const page = { path, palette, slug, shots: [], a11y: {}, layout: {}, vitals: null, errors: [] };
  report.pages.push(page);
  for (const mode of modes) {
    let url = path === "/" ? base : new URL(path, base).href; // "/" is the base URL itself (it may be a page)
    if (palette) { const u = new URL(url); u.searchParams.set("palette", palette); u.searchParams.set("mode", mode); url = u.href; }
    for (const w of [...widths].sort((a, b) => b - a)) {
      ab("set", "viewport", String(w), w < 600 ? "844" : "900");
      ab("set", "media", mode);
      ab("open", url);
      ab("wait", "--load", "networkidle");
      if (waitText) ab("wait", "--text", waitText);
      const name = `${slug}-${w}-${mode}.png`;
      ab("screenshot", join(out, name), ...(full ? ["--full"] : []));
      stampPng(join(out, name), { ...at, url, width: w, mode, takenAt: new Date().toISOString() });
      const shot = { name, width: w, mode };
      if (baseline) shot.compare = compare(name);
      page.shots.push(shot);
      const lay = JSON.parse(run(LAYOUT));
      page.layout[`${w}-${mode}`] = lay;
      if (lay.overflow > 1) blocking.push(`${path}${palette ? ` [${palette}]` : ""} ${w}px ${mode}: page scrolls sideways by ${lay.overflow}px (${lay.wide.join(", ") || "element not found"})`);
      if (lay.failed.length && w === Math.max(...widths)) blocking.push(`${path}${palette ? ` [${palette}]` : ""} ${mode}: failed loads: ${lay.failed.join(", ")}`);
      if (lay.tinyText.length) blocking.push(`${path}${palette ? ` [${palette}]` : ""} ${w}px ${mode}: text under 12px: ${lay.tinyText.join(", ")}`);
      if (w === Math.max(...widths)) {
        const a = abJson("a11y", "--tags", "wcag2a,wcag2aa,wcag21a,wcag21aa,wcag22aa");
        page.a11y[mode] = { violations: a.violations.map((v) => ({ id: v.id, impact: v.impact, help: v.help, nodes: v.nodeCount, targets: v.nodes.slice(0, 5).map((n) => n.target.join(" ")) })), incomplete: a.incomplete.map((v) => v.id) };
        for (const v of a.violations) if (v.impact === "serious" || v.impact === "critical") blocking.push(`${path}${palette ? ` [${palette}]` : ""} ${mode}: axe ${v.id} (${v.impact}, ${v.nodeCount}x): ${v.help} at ${v.nodes.slice(0, 3).map((n) => n.target.join(" ")).join("; ")}`);
        if (mode === modes[0]) {
          const vt = abJson("vitals", url);
          page.vitals = { lcp_ms: vt.lcp?.startTime ?? null, cls: vt.cls?.score ?? null, fcp_ms: vt.fcp ?? null, ttfb_ms: vt.ttfb ?? null, inp_ms: vt.inp ?? null };
          if ((page.vitals.lcp_ms ?? 0) > 2500) blocking.push(`${path}: LCP ${Math.round(page.vitals.lcp_ms)} ms (over 2.5 s)`);
          if ((page.vitals.cls ?? 0) > 0.1) blocking.push(`${path}: layout shift CLS ${page.vitals.cls} (over 0.1)`);
        }
        const consoleErrors = abJson("console").messages.filter((m) => m.type === "error").map((m) => `console: ${m.text}`);
        ab("console", "--clear");
        const errs = [ab("errors").trim(), ...consoleErrors].filter(Boolean).join("\n");
        if (errs) { page.errors.push(errs.slice(0, 2000)); blocking.push(`${path}${palette ? ` [${palette}]` : ""} ${mode}: page errors: ${errs.split("\n")[0].slice(0, 200)}`); }
        ab("errors", "--clear");
      }
    }
  }
}

// Routes: every link on the reviewed pages to another page of the app is clicked, and that page must render on the
// click, again after Back and Forward, and on a reload (answering under 400 and showing what the click showed). A URL
// that changes while the page stays the same is the commonest navigation bug in apps. Once, at the widest width in the
// first mode; one link per kind (its path and query names: ten "?item=" rows are one check), up to 12, the navigation's
// first. Skipped with --palettes (the catalog) and --no-routes (a mockup
// whose links lead nowhere yet). Findings name the link and its path only, so a baseline run can match them.
const ROUTE_LINKS = `/*routes:links*/(() => JSON.stringify([...document.querySelectorAll("a[href]")].map((a) => {
  const u = new URL(a.href, location.href), r = a.getBoundingClientRect();
  const ok = u.origin === location.origin && !a.target && !a.hasAttribute("download") && !u.pathname.startsWith("/api/") && !/\\.[a-z0-9]{2,5}$/i.test(u.pathname)
    && !/log-?out|sign-?out/i.test(u.pathname + " " + a.textContent) && u.pathname + u.search !== location.pathname + location.search && r.width > 0 && r.height > 0;
  return ok && { href: a.getAttribute("href"), to: u.pathname + u.search, kind: u.pathname + "?" + [...u.searchParams.keys()].sort(), label: (a.textContent || a.getAttribute("aria-label") || "").trim().replace(/\\s+/g, " ").slice(0, 40), nav: !!a.closest("nav,header,aside,[role=navigation]") };
}).filter(Boolean)))()`;
const ROUTE_MARK = (href) => `/*routes:mark*/(() => { document.querySelectorAll("[data-ui-review-link]").forEach((e) => e.removeAttribute("data-ui-review-link"));
  const a = [...document.querySelectorAll("a[href]")].find((e) => e.getAttribute("href") === ${JSON.stringify(href)} && e.getBoundingClientRect().width > 0);
  if (a) a.setAttribute("data-ui-review-link", ""); return a ? "ok" : "missing"; })()`;
const ROUTE_PAGE = `/*routes:page*/(() => JSON.stringify({ at: location.pathname + location.search, status: performance.getEntriesByType("navigation")[0]?.responseStatus ?? 0,
  text: (document.body?.innerText || "").replace(/\\s+/g, " ").trim().slice(0, 20000) }))()`;
/** How alike two pages' text is (shared words over all words, 0..1): live clocks and counts don't make two views of one page differ. */
function alike(a, b) {
  const words = (t) => new Set(t.toLowerCase().replace(/\d+/g, "#").split(/[^\p{L}#]+/u).filter(Boolean));
  const A = words(a), B = words(b);
  let both = 0;
  for (const w of A) if (B.has(w)) both++;
  return A.size + B.size === 0 ? 1 : both / (A.size + B.size - both);
}
report.routes = [];
if (!palettes.length && !args.includes("--no-routes")) {
  ab("set", "viewport", String(Math.max(...widths)), "900");
  ab("set", "media", modes[0]);
  const settle = () => { ab("wait", "--load", "networkidle"); ab("wait", "300"); };
  const look = () => JSON.parse(run(ROUTE_PAGE));
  const links = [], seen = new Set();
  for (const path of paths) {
    try {
      ab("open", path === "/" ? base : new URL(path, base).href);
      settle();
      for (const l of JSON.parse(run(ROUTE_LINKS)).sort((a, b) => b.nav - a.nav)) {
        if (seen.has(l.kind)) continue;
        if (links.length === 12) { report.routesCut = true; break; }
        seen.add(l.kind);
        links.push({ ...l, from: path });
      }
    } catch (e) {
      report.routes.push({ from: path, link: "", to: "", problems: [], skipped: `couldn't read its links: ${String(e.stderr || e.message).split("\n")[0].slice(0, 160)}` });
    }
  }
  for (const l of links) {
    const route = { from: l.from, link: l.label, to: l.to, problems: [] };
    report.routes.push(route);
    try {
      ab("open", l.from === "/" ? base : new URL(l.from, base).href);
      settle();
      const start = look();
      if (run(ROUTE_MARK(l.href)) !== "ok") { route.skipped = "the link wasn't on the page when it was opened again"; continue; }
      try { ab("click", "[data-ui-review-link]"); } catch { run(`document.querySelector("[data-ui-review-link]").click()`); }
      settle();
      const clicked = look();
      if (clicked.at === start.at) route.problems.push(`clicking it leaves the URL at ${start.at}`);
      else if (clicked.text === start.text) route.problems.push(`clicking it changes the URL to ${clicked.at} but the page stays the same`);
      ab("back");
      settle();
      const back = look();
      if (back.at !== start.at) route.problems.push(`Back goes to ${back.at}, not ${start.at}`);
      else if (alike(back.text, start.text) < 0.8) route.problems.push(`Back to ${start.at} doesn't show that page again`);
      ab("forward");
      settle();
      const fwd = look();
      if (fwd.at !== clicked.at) route.problems.push(`Forward goes to ${fwd.at}, not ${clicked.at}`);
      else if (alike(fwd.text, clicked.text) < 0.8) route.problems.push(`Forward to ${clicked.at} doesn't show that page again`);
      ab("open", new URL(clicked.at, base).href);
      settle();
      const fresh = look();
      if (fresh.status >= 400) route.problems.push(`a reload of ${clicked.at} answers ${fresh.status}`);
      else if (alike(fresh.text, clicked.text) < 0.8) route.problems.push(`a reload of ${clicked.at} shows a different page than the click did`);
    } catch (e) {
      route.skipped = `couldn't check it: ${String(e.stderr || e.message).split("\n")[0].slice(0, 160)}`;
    }
    for (const p of route.problems) blocking.push(`${l.from} link "${l.label || l.href}" (${l.to}): ${p}`);
  }
}

/**
 * Split `found` (the head's findings) against `baseFound` (the base commit's). Findings are matched by their text, once
 * each: a base finding cancels one head finding, so a second instance of the same defect on the head is still the head's.
 * Without a base list nothing can be told apart, so everything is the head's (fail closed).
 */
function splitPreexisting(found = [], baseFound = []) {
  const left = new Map();
  for (const b of baseFound) left.set(b, (left.get(b) ?? 0) + 1);
  const introduced = [], preexisting = [];
  for (const b of found) {
    const n = left.get(b) ?? 0;
    if (n > 0) { left.set(b, n - 1); preexisting.push(b); } else introduced.push(b);
  }
  return { introduced, preexisting };
}

const baseReport = baseline && existsSync(join(baseline, "report.json")) ? JSON.parse(readFileSync(join(baseline, "report.json"), "utf8")) : null;
const { introduced, preexisting } = splitPreexisting(blocking, baseReport?.blocking);

const lines = [`# UI review of ${base}`, "", `${report.at} · widths ${widths.join("/")} · modes ${modes.join("/")}${palettes.length ? ` · palettes ${palettes.join("/")}` : ""}${baseline ? ` · baseline ${baseline}` : ""}`, ""];
lines.push(introduced.length ? `## Blocking (${introduced.length})` : "## Blocking: none found by the automated checks", "", ...introduced.map((b) => `- ${b}`), "");
if (preexisting.length) lines.push(`## Already on this base (${preexisting.length}): not this change's`, "", ...preexisting.map((b) => `- ${b}`), "");
lines.push("## Pages", "");
for (const p of report.pages) {
  lines.push(`### ${p.path}${p.palette ? ` [${p.palette}]` : ""}`, "");
  if (p.vitals) lines.push(`Vitals: LCP ${p.vitals.lcp_ms ?? "–"} ms · CLS ${p.vitals.cls ?? "–"} · FCP ${p.vitals.fcp_ms ?? "–"} ms · TTFB ${p.vitals.ttfb_ms ?? "–"} ms`);
  for (const [mode, a] of Object.entries(p.a11y)) lines.push(`Accessibility (${mode}): ${a.violations.length ? a.violations.map((v) => `${v.id} ${v.impact} ×${v.nodes}`).join(", ") : "no violations"}${a.incomplete.length ? `; check by eye: ${a.incomplete.join(", ")}` : ""}`);
  const small = Object.entries(p.layout).filter(([k, l]) => k.startsWith(String(Math.min(...widths))) && l.small).map(([, l]) => l.small)[0];
  if (small) lines.push(`Phone: ${small} controls are 24-43px tall (44px is the phone rule; check the main ones).`);
  lines.push("", "Screenshots (open each one):", ...p.shots.map((s) => `- ${s.name}${s.compare ? ` · before|after: ${s.compare.compare ?? "–"} · diff: ${s.compare.diff} (${s.compare.diffResult})` : ""}`), "");
}
if (report.routes.length) lines.push("## Routes (click, Back, Forward, reload)", "", ...report.routes.map((r) => `- ${r.from} → "${r.link}" ${r.to}: ${r.skipped ?? (r.problems.join("; ") || "renders")}`), ...(report.routesCut ? ["- (more kinds of link than the 12 checked: review the rest with --paths on their pages)"] : []), "");
lines.push("Automated checks find maybe a third of what matters. Now look at every screenshot against the review checklist.");
writeFileSync(join(out, "report.md"), lines.join("\n"));
writeFileSync(join(out, "report.json"), JSON.stringify({ ...report, blocking: introduced, preexisting }, null, 2));
console.log(`${join(out, "report.md")}: ${introduced.length} blocking, ${preexisting.length} already on this base, ${report.pages.reduce((n, p) => n + p.shots.length, 0)} screenshots`);
process.exit(introduced.length ? 1 : 0);
