#!/bin/sh
# repo-checkout <org/name> [full commit sha]: a snapshot of that commit (default: the default branch) of an agents-org repo
# at /workspace/repos/<name>.
# The launcher places the kernel's code host snapshot (POST /repo on the gateway); no git credentials ever enter this box.
# Only agents with the repo-checkout role may use it.
set -e
[ $# -eq 1 ] || [ $# -eq 2 ] || { echo "usage: repo-checkout <org/name> [full 40-character commit sha]" >&2; exit 2; }
# The job's own token (the launcher's job env file) names this box to the gateway.
[ -n "${AIDENHQ_RUN_TOKEN:-}" ] || { echo "repo-checkout: no job token (AIDENHQ_RUN_TOKEN)" >&2; exit 1; }
curl -sS --fail-with-body --max-time 180 -X POST -H "X-Agent-Key: $AIDENHQ_RUN_TOKEN" -H "content-type: application/json" \
  --data "$(jq -nc --arg r "$1" --arg s "${2:-}" '{repo: $r, sha: $s}')" "${AIDENHQ_GATEWAY_URL:-http://10.231.2.1:8200}/repo"
echo
