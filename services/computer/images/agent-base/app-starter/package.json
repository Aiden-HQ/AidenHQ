{
  "name": "app",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "catalog": "vite --open /catalog.html",
    "build": "tsc -p tsconfig.json && vite build",
    "start": "node server.mjs",
    "preview": "npm run build && HOST=127.0.0.1 PORT=${PORT:-4173} node server.mjs",
    "test": "vitest run && node --test test/*.test.mjs",
    "screens": "playwright test",
    "lint": "oxlint src --deny-warnings",
    "aidenhq:fast-check": "test -d node_modules || { echo skipped: run npm ci first; exit 0; }; npm run lint && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "get-nonce": "1.0.1",
    "lucide-react": "1.73.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "happy-dom": "21.0.4",
    "oxlint": "1.94.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
