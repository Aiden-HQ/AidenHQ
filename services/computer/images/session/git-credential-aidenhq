#!/bin/sh
# git's credential helper in a session box (/opt/aidenhq/bin/git-credential-aidenhq, set by `gitconfig` beside it): for an https
# github.com remote it asks the kernel (POST /v1/jobtools/git-token, through the box gateway, as the job) for a one-hour GitHub
# App installation token narrowed to that one repo, and hands git that. The owner's token never enters the box, and nothing is
# stored: git asks again each time (`store`/`erase` do nothing).
set -e
[ "$1" = get ] || exit 0
proto=; host=; path=
while IFS= read -r line && [ -n "$line" ]; do
  case "$line" in protocol=*) proto="${line#protocol=}";; host=*) host="${line#host=}";; path=*) path="${line#path=}";; esac
done
[ "$proto" = https ] && [ "$host" = github.com ] || exit 0
repo="${path%.git}"
case "$repo" in */*) ;; *) echo "git-credential-aidenhq: no repository in the remote (credential.useHttpPath must be true)" >&2; exit 1;; esac
[ -n "${AIDENHQ_RUN_TOKEN:-}" ] || { echo "git-credential-aidenhq: no job token (AIDENHQ_RUN_TOKEN)" >&2; exit 1; }
out=$(curl -sS --max-time 30 -X POST -H "authorization: Bearer $AIDENHQ_RUN_TOKEN" -H "content-type: application/json" \
  --data "$(jq -nc --arg r "$repo" '{repo: $r}')" -w '\n%{http_code}' "${AIDENHQ_GATEWAY_URL:-http://10.231.2.1:8200}/v1/jobtools/git-token") \
  || { echo "git-credential-aidenhq: the gateway didn't answer" >&2; exit 1; }
code=$(printf '%s' "$out" | tail -n 1); body=$(printf '%s' "$out" | sed '$d')
if [ "$code" != 200 ]; then
  echo "git-credential-aidenhq: no token for $repo ($code): $(printf '%s' "$body" | jq -r '.error.message // .error // .message // .' 2>/dev/null | head -c 300)" >&2
  exit 1
fi
printf 'username=x-access-token\npassword=%s\n' "$(printf '%s' "$body" | jq -r .token)"
