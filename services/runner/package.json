{
  "name": "aidenhq-runner",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "description": "Runs Codex/OpenRouter coding jobs on the host for Paperclip tasks labelled 'engineer'.",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/main.mjs",
    "test": "npm run typecheck && node --disable-warning=ExperimentalWarning --test test/*.test.mjs",
    "test:unit": "npm run typecheck && node --disable-warning=ExperimentalWarning --test $(ls test/*.test.mjs | grep -vE '^test/(flow-|box\\.|adopt\\.)')",
    "test:flows": "node --disable-warning=ExperimentalWarning --test test/flow-*.test.mjs test/box.test.mjs test/adopt.test.mjs",
    "eval:busy": "node --disable-warning=ExperimentalWarning eval/busy.mjs",
    "typecheck": "tsc -p . && ! (tsc -p . --checkJs | grep \"error TS2304\")"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  }
}
