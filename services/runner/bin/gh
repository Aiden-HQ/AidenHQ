#!/usr/bin/env bash
# Read-only gh for AidenHQ coding agents. Placed first on the agent's PATH; forwards
# read commands to the real gh and refuses anything that writes to GitHub.
# (The runner itself uses the real gh for human-approved `push` / `pr` commands.)
set -euo pipefail

self_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
real=""
IFS=: read -r -a dirs <<< "$PATH"
for d in "${dirs[@]}"; do
  [ "$d" = "$self_dir" ] && continue
  if [ -x "$d/gh" ]; then real="$d/gh"; break; fi
done
[ -n "$real" ] || { echo "gh (aidenhq): real gh not found on PATH" >&2; exit 127; }

deny() { echo "gh (aidenhq): '$*' is blocked — agents have read-only GitHub access. Report what should be done instead." >&2; exit 3; }
# GitHub reads go through GH_TOKEN only: the runner's GitHub App token, read-only and narrowed to the task's repos the
# App covers. The user's own gh sign-in is hidden from jobs, so without it gh has no access at all: say so plainly.
need_token() {
  case "$sub" in ""|--help|-h|help|version|--version) return ;; esac
  # Codex drops *TOKEN* variables from its tool calls: the runner passes the same token as AIDENHQ_GH_AUTH too.
  [ -n "${GH_TOKEN:-}" ] || [ -z "${AIDENHQ_GH_AUTH:-}" ] || export GH_TOKEN="$AIDENHQ_GH_AUTH"
  [ -n "${GH_TOKEN:-}" ] || { echo "gh (aidenhq): no GitHub access in this run: the AidenHQ GitHub App isn't installed on this task's repositories. Use \`aidenhq status\` for the task's branches and PRs, and say what else you need read." >&2; exit 4; }
}

sub="${1:-}"; action="${2:-}"
case "$sub" in
  ""|--help|-h|help|version|--version|status|search|browse) ;;
  auth) [ "$action" = "status" ] || deny "$@" ;;
  api)
    # Only GET requests: reject explicit methods other than GET and any field/input flags
    # (which turn a request into a POST).
    shift
    method="GET"
    for ((i = 1; i <= $#; i++)); do
      a="${!i}"
      case "$a" in
        -X|--method) j=$((i + 1)); method="${!j:-}";;
        -X*) method="${a#-X}";;
        --method=*) method="${a#--method=}";;
        -f|-F|--field|--raw-field|--input|-f*|-F*|--field=*|--raw-field=*|--input=*) deny "api with request body" ;;
      esac
    done
    [ "$(printf %s "$method" | tr a-z A-Z)" = "GET" ] || deny "api -X $method"
    need_token
    exec "$real" api "$@"
    ;;
  pr|issue|run|workflow|release|repo|gist|label|project|cache|secret|variable|ruleset|codespace|org|attestation)
    case "$action" in
      ""|list|view|diff|checks|status|watch|download|--help|-h) ;;
      clone) [ "$sub" = "repo" ] || deny "$@" ;;
      *) deny "$@" ;;
    esac
    ;;
  *) deny "$@" ;;
esac
need_token
exec "$real" "$@"
