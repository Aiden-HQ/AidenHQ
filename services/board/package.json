{
  "name": "aidenhq-board",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build -c web/vite.config.ts",
    "dev:web": "vite -c web/vite.config.ts",
    "start": "node dist/src/main.js",
    "test": "sh test.sh",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "lint": "oxlint web/src --deny-warnings && stylelint \"web/src/**/*.css\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "pino": "10.4.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@happy-dom/global-registrator": "21.0.4",
    "@types/bun": "1.4.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "dompurify": "3.4.18",
    "marked": "18.2.0",
    "oxlint": "1.94.0",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "stylelint": "18.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "overrides": {
    "@csstools/css-calc": "3.4.3",
    "@csstools/css-parser-algorithms": "4.0.2",
    "@csstools/css-syntax-patches-for-csstree": "1.1.16",
    "@csstools/css-tokenizer": "4.0.2",
    "@csstools/media-query-list-parser": "5.0.2",
    "colord": "2.12.0",
    "ignore": "7.0.14",
    "postcss-selector-parser": "7.2.0"
  }
}
