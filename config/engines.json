{
  "claude": {
    "kind": "claude",
    "bin": "modules/engine-claude/bin/engine",
    "live_input": true,
    "label": "Claude Code",
    "adapter": "claude_local",
    "effort_key": "effort",
    "state": "shared",
    "ro": [
      "~/.local/share/claude"
    ],
    "secret_env": {
      "CLAUDE_CODE_OAUTH_TOKEN": "claude_oauth_token"
    },
    "module": "engine-claude",
    "dir": "modules/engine-claude"
  },
  "codex": {
    "kind": "codex",
    "bin": "modules/engine-codex/bin/engine",
    "label": "Codex",
    "adapter": "codex_local",
    "effort_key": "modelReasoningEffort",
    "rw": [
      "~/.codex"
    ],
    "crew": {
      "adapter": "codex_local",
      "args": [
        "--sandbox",
        "read-only",
        "--skip-git-repo-check",
        "-c",
        "features.apps=false",
        "-c",
        "features.shell_tool=false",
        "-c",
        "features.unified_exec=false",
        "-c",
        "features.apps=false",
        "-c",
        "features.browser_use=false",
        "-c",
        "features.browser_use_external=false",
        "-c",
        "features.in_app_browser=false",
        "-c",
        "features.computer_use=false",
        "-c",
        "features.image_generation=false",
        "-c",
        "web_search=\"live\"",
        "-c",
        "model_provider=\"or\"",
        "-c",
        "model_providers.or.name=\"OpenRouter\"",
        "-c",
        "model_providers.or.base_url=\"http://10.231.0.1:8201/api/v1\"",
        "-c",
        "model_providers.or.env_key=\"PAPERCLIP_API_KEY\"",
        "-c",
        "model_providers.or.wire_api=\"responses\""
      ]
    },
    "module": "engine-codex",
    "dir": "modules/engine-codex",
    "live_input": false
  },
  "codex-openrouter": {
    "kind": "codex-openrouter",
    "bin": "modules/engine-codex/bin/engine",
    "label": "Codex on OpenRouter",
    "effort_key": "modelReasoningEffort",
    "model_prefix": "openrouter/",
    "gateway": true,
    "box": true,
    "state": "task",
    "reset": [
      "AGENTS.md",
      "AGENTS.override.md",
      "skills",
      "config.toml",
      "auth.json",
      "hooks.json",
      "rules",
      "plugins",
      ".agents"
    ],
    "seed": [
      {
        "from": "codex-home/AGENTS.md",
        "to": "AGENTS.md"
      },
      {
        "from": "codex-home/skills",
        "to": "skills"
      },
      {
        "from": "/modules/core/design-system",
        "to": "skills/design-system/files"
      },
      {
        "from": "/modules/core/templates/app",
        "to": "skills/design-system/starter"
      },
      {
        "from": "/scripts/supply-chain/best-version.mjs",
        "to": "skills/supply-chain/best-version.mjs"
      }
    ],
    "module": "engine-codex",
    "dir": "modules/engine-codex",
    "live_input": false
  },
  "openrouter": {
    "kind": "openrouter",
    "bin": "modules/engine-opencode/bin/engine",
    "label": "OpenRouter {model}",
    "adapter": "opencode_local",
    "effort_key": "modelReasoningEffort",
    "model_prefix": "openrouter/",
    "gateway": true,
    "rw": [
      "~/.local/share/opencode",
      "~/.local/state/opencode",
      "~/.cache/opencode",
      "~/.config/opencode"
    ],
    "gcloud": false,
    "module": "engine-opencode",
    "dir": "modules/engine-opencode",
    "live_input": false
  }
}
