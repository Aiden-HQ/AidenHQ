[Unit]
Description=AidenHQ kernel (kernel/src/main.ts): the model gateway, the tool proxy and the jobs
After=network-online.target

[Service]
# The product checkout: ~/aidenhq, or where ops/setup.sh recorded it (~/.config/aidenhq-checkout.env).
Environment=AIDENHQ_DIR=%h/aidenhq
EnvironmentFile=-%h/.config/aidenhq-checkout.env
# The secret vault must be mounted (ops/vault): the model key and the connections' service keys are read from it at each
# call. It also listens on the backplane's gateway address (10.231.0.1: the model gateway on 8201, the tool proxy on 3130),
# which exists once compose is up: the kernel retries those binds itself while loopback serves.
ExecStartPre=/usr/bin/mountpoint -q %h/.config/aidenhq
# kernel/run.sh starts the kernel and, on a stop or restart, has it drain: the model calls in flight finish in the old kernel
# while the next one takes new calls.
ExecStart=/bin/sh ${AIDENHQ_DIR}/kernel/run.sh
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Restart=always
RestartSec=5
# A stop or restart signals run.sh only: the draining kernel and the jobs it started keep running (their own process groups),
# and the next kernel adopts the jobs from kernel.db (kernel/src/jobs.ts).
KillMode=process

[Install]
WantedBy=default.target
