[Unit]
Description=AidenHQ Docker cleanup (build cache over 20 GB, images unused for two days, one-off containers stopped over a day)

[Service]
# Every deploy rebuilds images; old ones and the build cache filled the VM disk. The steps live in ops/prune-docker.sh:
# it runs each one whatever the ones before it did (a buildx flag or plugin problem must never skip the image prune — that
# is the shape of the 45 h with no drop on 2026-11-20/21), and it fails once they are all attempted when any of them did
# not do its work, so a degraded prune is a failed unit (UnitFailed) rather than a silent success.
#
# The product checkout: ~/aidenhq, or where ops/setup.sh recorded it (~/.config/aidenhq-checkout.env).
Environment=AIDENHQ_DIR=%h/aidenhq
EnvironmentFile=-%h/.config/aidenhq-checkout.env
# The checkout the last apply applied (ops/apply-config-work.sh writes it): read after the checkout file, so it wins.
EnvironmentFile=-%h/.config/aidenhq-prune-docker.env
Type=oneshot
# A 100 GB build cache takes longer than systemd's 90 s default to prune; a start timeout would kill it mid-run and mark
# the unit failed while it was working.
TimeoutStartSec=30min
ExecStart=/usr/bin/env bash ${AIDENHQ_DIR}/ops/prune-docker.sh
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
