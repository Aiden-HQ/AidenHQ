[Unit]
Description=AidenHQ Docker cleanup (build cache over 20 GB, images unused for two days, one-off containers stopped over a day)

[Service]
# Every deploy rebuilds images; old ones and the build cache filled the VM disk. Keep two days of images for rollbacks;
# images a container still uses are never removed. The build cache is capped by size, least recently used first: an
# `until` filter freed nothing on the containerd image store (104 GB of cache on the EX44, 2026-11-18), so the size cap
# is the thing that has to hold.
#
# Each prune is independent: the `-` prefix makes systemd ignore that command's exit status, so a failed builder prune
# (a buildx flag or plugin problem, a 20 s status timeout) never skips the image or container prune below. Each command
# also has its own `timeout`, well under TimeoutStartSec, so a daemon that hangs one prune cannot stop systemd from
# reaching the later steps and the verification.
#
# The cap is attempted in both flag forms because which one the CLI knows depends on whether the buildx plugin is
# installed. On this host both forms run buildx: `--max-used-space` caps the cache, while `--keep-storage` is a
# deprecated alias for `--reserved-space` (a reservation, not a cap); the second form stays as the classic builder's cap
# on a host without the plugin.
#
# `-a` on both is what lets the prune reach internal/frontend and shared-with-image records. Without it they survive and
# `docker system df` still counts them in Size and Reclaimable, so the cache never falls to the ceiling.
# Each records its status through the same wrapper as the other steps: one failing is expected (`unknown flag` on a CLI
# that lacks that form), but both failing means no form capped the cache, and the verification must see that even when a
# cache under its ceiling would otherwise read clean.
ExecStart=-/usr/bin/env bash ${AIDENHQ_DIR}/ops/prune-docker-step.sh builder-buildx /usr/bin/timeout 15m /usr/bin/docker builder prune -af --max-used-space 20GB
ExecStart=-/usr/bin/env bash ${AIDENHQ_DIR}/ops/prune-docker-step.sh builder-classic /usr/bin/timeout 15m /usr/bin/docker builder prune -af --keep-storage 20GB
# The cache as it is once the two builder prunes have finished, read here — before the image and container prunes, which
# take minutes on a large host — so the verification judges the ceiling on the result of pruning, not on a snapshot a build
# started since has grown. Prefixed like every other step; its status and rows are what the verification reads.
ExecStart=-/usr/bin/env bash ${AIDENHQ_DIR}/ops/prune-docker-step.sh build-cache /usr/bin/timeout 30 /usr/bin/docker system df --format '{{json .}}'
# The image prune goes through ops/prune-docker-step.sh, which records its status for the last step: the failure must not
# skip the steps below, but it must still fail the unit, and running the same 48 h prune a second time in the verification
# would double the work on a large host.
ExecStart=-/usr/bin/env bash ${AIDENHQ_DIR}/ops/prune-docker-step.sh images /usr/bin/timeout 10m /usr/bin/docker image prune -af --filter until=48h --filter label!=aidenhq.keep=true
# A one-off that dies without --rm keeps its whole writable layer forever, and nothing else prunes stopped containers. Only
# containers that are stopped AND over a day old go; container prune never removes a volume, so no data is touched. The
# script (ops/prune-docker-containers.sh) checks `State.FinishedAt` — `docker container prune --filter until=` filters on
# created time, so it could remove a compose service an apply's generation snapshot had just stopped. The script records its
# own exit status under this invocation (the same record the image step's wrapper writes): a listing that failed while the
# daemon was unreachable can recover before the verification's own re-listing, and a fresh listing with nothing to remove
# would then read as a clean scan — the record is how the verification still sees this run's scan never completed.
ExecStart=-/usr/bin/timeout 5m /usr/bin/env bash ${AIDENHQ_DIR}/ops/prune-docker-containers.sh
# The computer images carry aidenhq.keep=true, which the image prune above skips: this removes the superseded ones (see the script).
ExecStart=-/usr/bin/timeout 5m /usr/bin/env bash ${AIDENHQ_DIR}/ops/prune-computer-images.sh
# Not prefixed: the one step whose failure must reach systemd. It re-reads the host — daemon answering, build cache under
# its 40 GB ceiling (a backstop for a prune that did nothing, above the fleet's 29.9 GB peak, not the 20 GB target), no
# one-off stopped over a day still there — and reads the image and container steps' recorded status, so a prune that did
# nothing at all is a failed unit (UnitFailed), not a silent success, while each step above still ran whatever the ones
# before it did.
ExecStart=/usr/bin/env bash ${AIDENHQ_DIR}/ops/prune-docker-verify.sh

# The product checkout: ~/aidenhq, or where ops/setup.sh recorded it (~/.config/aidenhq-checkout.env).
Environment=AIDENHQ_DIR=%h/aidenhq
EnvironmentFile=-%h/.config/aidenhq-checkout.env
# The checkout the last apply applied (ops/apply-config-work.sh writes it): read after the checkout file, so it wins.
EnvironmentFile=-%h/.config/aidenhq-prune-docker.env
Type=oneshot
# A 100 GB build cache takes longer than systemd's 90 s default to prune; a start timeout would kill it mid-run and mark
# the unit failed while it was working. It is the ceiling for the whole run, so it is above the per-command timeouts
# (15 + 15 + 10 + 5 min + 30 s) plus the verification.
TimeoutStartSec=50min
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
