[Unit]
Description=AidenHQ Docker cleanup (build cache and images nothing has used for two days)

[Service]
Type=oneshot
# Every deploy rebuilds images; old ones and the build cache filled the VM disk. Keep two days for rollbacks; images a
# container still uses are never removed. Computer images are rebuilt by apply-config when missing.
ExecStart=/usr/bin/docker builder prune -f --filter until=48h
ExecStart=/usr/bin/docker image prune -af --filter until=48h
