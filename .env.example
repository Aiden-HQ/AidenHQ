# Copy to .env and adjust. Paths are on the host.

# Host user that owns the vault/transcripts (id -u / id -g).
PUID=1000
PGID=100

# apps-mcp: the docker group's gid (bootstrap.sh adds it) and the work company's Paperclip id.
# DOCKER_GID=
# WORK_COMPANY_ID=
# Agent-built apps have their own tailnet node (compose.yaml apps-edge), never the board's name: browsers send a
# name's cookies to every port of it. Apps are served at <base>:<port>.
# APPS_TS_HOSTNAME=aidenhq-apps
# APPS_URL_BASE=https://aidenhq-apps.<tailnet>.ts.net

# Directory with secret files (0700 dir, 0600 files). Never inside the repo.
AIDENHQ_SECRETS_DIR=/home/USER/.config/aidenhq

# Persistent state (Paperclip DB/workspaces, ops-mcp SQLite).
AIDENHQ_DATA_DIR=./data

# Meetings module (ops-mcp). Host paths stay here, on the host, never in instance.yaml (agents can edit that
# through apply). scripts/compile.mjs mounts only the listed vault folders (comma-separated, vault-relative) and the
# knowledge bases (name=/path, read-only) into ops-mcp.
TRANSCRIPTS_DIR=/home/USER/Documents/transcripts
VAULT_DIR=/home/USER/obsidian/vault
VAULT_FOLDERS=Meetings
# KNOWLEDGE_BASES=aggbrain=/home/USER/.claude/plugins/marketplaces/aggbrain
KNOWLEDGE_BASES=

# Your private instance repo checkout: instance.yaml, apps.yaml, agents/<key>.md.
AIDENHQ_INSTANCE_DIR=/home/USER/aidenhq-instance
# Where apps-mcp pushes registry changes (default: the agents org's aidenhq-instance over https with a GitHub App
# token when the App is configured, else the instance checkout's origin remote).
# AIDENHQ_INSTANCE_PUSH_URL=git@github.com:your-org/aidenhq-instance.git
# A local instance repo (no GitHub; ops/setup.sh): the bare repo on this host that is the checkout's origin. Set
# AIDENHQ_INSTANCE_PUSH_URL to the same path; apps-mcp mounts it.
# AIDENHQ_INSTANCE_REMOTE=/home/USER/aidenhq-instance.git

# Set to true after you have created your Paperclip account.
PAPERCLIP_DISABLE_SIGN_UP=false

GOOGLE_CALENDAR_ID=primary

# Include the generated module services (node scripts/compile.mjs).
COMPOSE_FILE=compose.yaml:compose.modules.yaml

# Testing only: serve fixtures/ instead of Google (unset for real Calendar/Drive).
# GOOGLE_FIXTURES_DIR=/fixtures

# Slack MCP OAuth client (a public client ID registered for your Slack workspace; no secret). See README › Slack.
SLACK_CLIENT_ID=

# Primer, Glean, Grafana, ClickHouse and Jira: their URLs are instance settings (settings.primer_mcp_url,
# glean_mcp_url, grafana_url, clickhouse_mcp_url, jira_url), set on the board (Settings, Connections), not here.

# GitHub (github-mcp): the Researcher reads issues and pull requests with your gh token (run
# scripts/github-auth.sh), and comments or opens issues, when you ask, only in these organizations (comma-separated).
GITHUB_COMMENT_ORGS=

# Board (services/board): host names it answers to. Add your tailnet name for the phone, e.g.
# BOARD_ALLOWED_HOSTS=localhost:3120,127.0.0.1:3120
# The board's second listener (3121, signed-in admins only, like 3120): phones on the home network at
# http://aidenhq.local (publish it on the LAN with BOARD_LAN_BIND), and the board anywhere over Tailscale
# (`tailscale serve --bg --https=443 http://127.0.0.1:3121`): add the tailnet name to BOARD_LAN_HOSTS and
# set BOARD_LAN_URL to it (account links open there). Never BOARD_LAN_BIND=0.0.0.0 on a host with a public address.
# BOARD_LAN_BIND=0.0.0.0
# BOARD_LAN_PORT=80
# BOARD_LAN_HOSTS=aidenhq.local
# BOARD_LAN_URL=https://<machine>.<tailnet>.ts.net

# Your Slack user ID (slack module). Host-only: it decides whose Slack words count and who gets paged.
OWNER_SLACK_USER_ID=U00000000
# Where task IDs in Telegram messages link to (slack module). Host-only, like every link target in messages to you.
# TELEGRAM_TASK_URL=https://<your-paperclip-host>/WOR/issues/{id}

# Host firewall (ops/vm/setup.sh, read when setup runs): the interface whose inbound is limited to SSH (22) and what
# settings.exposure needs (tailscale: UDP 41641; public: 443). Unset = the default-route interface. `none` only on a LAN-only VM with no public address
# (e.g. one whose compose.override.yaml publishes Paperclip or the board on the LAN).
# AIDENHQ_PUBLIC_IF=eth0
