# Copy to .env and adjust. Paths are on the host.

# Host user that owns the vault/transcripts (id -u / id -g). The Paperclip image only runs as uid 1000, so PUID must be 1000.
PUID=1000
PGID=100

# apps-mcp: the docker group's gid (bootstrap.sh adds it) and the work company's Paperclip id.
# DOCKER_GID=
# WORK_COMPANY_ID=
# Agent-built apps have their own tailnet node (compose.yaml apps-edge), never the board's name: browsers send a
# name's cookies to every port of it. Apps are served at <base>:<port>.
# APPS_TS_HOSTNAME=aidenhq-apps
# APPS_URL_BASE=https://aidenhq-apps.<tailnet>.ts.net

# Directory with secret files (0700 dir, 0600 files). Never inside the repo.
AIDENHQ_SECRETS_DIR=/home/USER/.config/aidenhq

# Persistent state (Paperclip DB/workspaces, ops-mcp SQLite).
AIDENHQ_DATA_DIR=./data

# The host's apply state (generations.jsonl: the current product pin and the last 20 applies), read-only into the board.
AIDENHQ_STATE_DIR=/home/USER/.local/state/aidenhq

# Meetings module (ops-mcp). Host paths stay here, on the host, never in instance.yaml (agents can edit that
# through apply). scripts/compile.ts mounts only the listed vault folders (comma-separated, vault-relative) and the
# knowledge bases (name=/path, read-only) into ops-mcp.
TRANSCRIPTS_DIR=/home/USER/Documents/transcripts
VAULT_DIR=/home/USER/obsidian/vault
VAULT_FOLDERS=Meetings
# KNOWLEDGE_BASES=aggbrain=/home/USER/.claude/plugins/marketplaces/aggbrain
KNOWLEDGE_BASES=

# Your private instance repo checkout: instance.yaml, apps.yaml, agents/<key>.md.
AIDENHQ_INSTANCE_DIR=/home/USER/aidenhq-instance
# Where apps-mcp pushes registry changes (default: the fleet org's aidenhq-instance over https, written through the code
# host's commit op as you, when github_fleet_org is set; else the instance checkout's origin remote).
# AIDENHQ_INSTANCE_PUSH_URL=git@github.com:your-org/aidenhq-instance.git
# A local instance repo (no GitHub; ops/setup.sh): the bare repo on this host that is the checkout's origin. Set
# AIDENHQ_INSTANCE_PUSH_URL to the same path; apps-mcp mounts it.
# AIDENHQ_INSTANCE_REMOTE=/home/USER/aidenhq-instance.git

# Paperclip sign-up, open only until your Paperclip account exists: set it to true then (ops/setup.sh does). Unset means
# closed.
PAPERCLIP_DISABLE_SIGN_UP=false

GOOGLE_CALENDAR_ID=primary

# Include the generated module services (node scripts/compile.ts).
COMPOSE_FILE=compose.yaml:compose.modules.yaml

# Testing only: serve fixtures/ instead of Google (unset for real Calendar/Drive).
# GOOGLE_FIXTURES_DIR=/fixtures

# Slack MCP OAuth client ID: now saved from the slack module's setup flow on the board. A value here is read only while
# that is empty (an upgraded instance keeps working).
SLACK_CLIENT_ID=

# Jira's URL is an instance setting (settings.jira_url), set on the board (Settings, Connections), not here. Primer, Glean,
# Grafana and ClickHouse: their addresses are saved from the module's setup flow.

# The kernel's admin listener (127.0.0.1:3120: sign-in and approvals) behind its own front door, e.g.
# `tailscale serve --bg --https=8444 http://127.0.0.1:3120`; account links and the board's approval links open here.
# AIDENHQ_ADMIN_URL=https://<machine>.<tailnet>.ts.net:8444
# The board (3121, signed-in admins only: the kernel's session), on loopback behind the front door, e.g.
# Tailscale (`tailscale serve --bg --https=443 http://127.0.0.1:3121`): add the tailnet name to BOARD_LAN_HOSTS and
# set BOARD_LAN_URL to it (account links open there). Only a LAN VM in local exposure with AIDENHQ_PUBLIC_IF=none may
# publish it on the LAN (BOARD_LAN_BIND, e.g. http://aidenhq.local); verify-security fails it anywhere else.
# BOARD_LAN_BIND=0.0.0.0
# BOARD_LAN_PORT=80
# BOARD_LAN_HOSTS=aidenhq.local
# BOARD_LAN_URL=https://<machine>.<tailnet>.ts.net
# Public exposure (settings.exposure: public): Caddy's address, this host's public IPv4. Compile writes config/Caddyfile
# for it (scripts/front-door.ts) and checks that BOARD_LAN_URL is https://<ip> and AIDENHQ_ADMIN_URL https://<ip>:8446;
# ops/setup.sh --exposure public writes all three, and AIDENHQ_LINK_TTL_HOURS=24 (one-time links).
# AIDENHQ_PUBLIC_IP=203.0.113.7
# The mode ops/setup.sh set this host up for (public, tailscale or local): compile refuses an instance whose
# settings.exposure differs, so only a rerun of setup moves the board's door.
# AIDENHQ_EXPOSURE=public

# Where task IDs in Telegram messages link to (slack module). Host-only, like every link target in messages to you.
# TELEGRAM_TASK_URL=https://<your-paperclip-host>/WOR/issues/{id}

# Host firewall (ops/vm/setup.sh, read when setup runs): the interface whose inbound is limited to SSH (22) and what
# settings.exposure needs (tailscale: UDP 41641; public: 443 and 8446). Unset = the default-route interface. `none` only on a
# LAN-only VM with no public address (e.g. one whose compose.override.yaml publishes Paperclip on the LAN).
# AIDENHQ_PUBLIC_IF=eth0
