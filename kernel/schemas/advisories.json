{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aidenhq.dev/schemas/advisories.json",
  "title": "A marketplace's advisories.json (spec §6.7): read from the marketplace's head, it flags installed module shas that descend from an affected commit and not from the fix. Notify only: pins never change. kernel/src/advisories.ts holds a file to this; a file that breaks it is ignored and logged.",
  "type": "object",
  "additionalProperties": false,
  "required": ["advisories"],
  "properties": {
    "advisories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "module", "affected", "severity", "summary"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{1,15}-\\d{4}-\\d{1,6}$" },
          "module": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
          "affected": { "type": "array", "items": { "type": "string", "pattern": "^[0-9a-f]{40}$" } },
          "fixed": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
          "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "url": { "type": "string", "pattern": "^https://[A-Za-z0-9.~:/?#@!$&+,;=%_-]{1,500}$" }
        }
      }
    }
  }
}
