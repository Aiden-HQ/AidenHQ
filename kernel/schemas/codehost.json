{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A module's code host grant (module.yaml codehost:), taken literally: what it may ask the kernel's POST /v1/codehost/:op for, each acting as the owner's GitHub sign-in inside the github module. repos: owner/name, owner/* (every repo of owner), */* (anything the owner's account reaches), or @instance, @product, @orgs (every repo of the instance's github_orgs), @maintained (its maintainer_repos), @agents/<name|*> (the fleet org), which the kernel resolves from its own configuration. snapshot and clone read code; fetch (and head) fetch refs or a branch's head; read, comment and commit are typed GitHub operations (commit names the exact paths it may write); runner names the orgs it may get a runner registration token for.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repos"
      ],
      "properties": {
        "repos": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^(@instance|@product|@orgs|@maintained|@agents/([\\w.-]+|\\*)|[\\w.-]+/([\\w.-]+|\\*)|\\*/\\*)$"
          }
        }
      }
    },
    "clone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repos"
      ],
      "properties": {
        "repos": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^(@instance|@product|@orgs|@maintained|@agents/([\\w.-]+|\\*)|[\\w.-]+/([\\w.-]+|\\*)|\\*/\\*)$"
          }
        }
      }
    },
    "fetch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repos"
      ],
      "properties": {
        "repos": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^(@instance|@product|@orgs|@maintained|@agents/([\\w.-]+|\\*)|[\\w.-]+/([\\w.-]+|\\*)|\\*/\\*)$"
          }
        }
      }
    },
    "read": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repos"
      ],
      "properties": {
        "repos": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^(@instance|@product|@orgs|@maintained|@agents/([\\w.-]+|\\*)|[\\w.-]+/([\\w.-]+|\\*)|\\*/\\*)$"
          }
        }
      }
    },
    "comment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repos"
      ],
      "properties": {
        "repos": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^(@instance|@product|@orgs|@maintained|@agents/([\\w.-]+|\\*)|[\\w.-]+/([\\w.-]+|\\*)|\\*/\\*)$"
          }
        }
      }
    },
    "commit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repos",
        "paths"
      ],
      "properties": {
        "repos": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^(@instance|@product|@orgs|@maintained|@agents/([\\w.-]+|\\*)|[\\w.-]+/([\\w.-]+|\\*)|\\*/\\*)$"
          }
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[\\w.][\\w./-]{0,499}$"
          }
        }
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orgs"
      ],
      "properties": {
        "orgs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^([\\w.-]+|\\*)$"
          }
        }
      }
    }
  }
}
